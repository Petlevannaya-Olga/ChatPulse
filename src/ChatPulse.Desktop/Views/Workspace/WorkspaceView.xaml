<UserControl x:Class="ChatPulse.Desktop.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="OnVisibilityChanged"
             FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <LinearGradientBrush x:Key="WorkspaceBackground" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.52" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <Style x:Key="WorkspaceChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ChatBackground" Background="White"
                                CornerRadius="10" BorderBrush="#E9DEF8" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ChatBackground" Property="Background" Value="#EEE5FF" />
                                <Setter TargetName="ChatBackground" Property="BorderBrush" Value="#A879E6" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChatBackground" Property="BorderBrush" Value="#AE8CDD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceOpenLinkButton" TargetType="Button">
            <Setter Property="Background" Value="#F0E6FF" />
            <Setter Property="Foreground" Value="#6836AB" />
            <Setter Property="BorderBrush" Value="#D9C3F3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource WorkspaceBackground}">
        <Border Margin="25" CornerRadius="22" Background="White" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="296" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#F8F5FF" BorderBrush="#E9DEF8" BorderThickness="0,0,1,0">
                    <Grid Margin="20,26,20,22">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                            <Border Width="46" Height="46" CornerRadius="23" Background="#F0E5FF"
                                    BorderBrush="#A74BF0" BorderThickness="2">
                                <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="48" Height="48">
                                        <Path Data="M 12,8 H 35 A 7,7 0 0 1 42,15 V 27 A 7,7 0 0 1 35,34 H 29 L 24,40 V 34 H 12 A 7,7 0 0 1 5,27 V 15 A 7,7 0 0 1 12,8 Z"
                                              Fill="Transparent" Stroke="#8241D8" StrokeThickness="3.3" StrokeLineJoin="Round" />
                                        <Path Data="M 14,19 H 33 M 14,25 H 27" Stroke="#8241D8" StrokeThickness="3.3"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ChatPulse" Foreground="#24154C" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Рабочая область" FontSize="12" Foreground="#796C98" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Подключённые чаты" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#24154C" Margin="4,0,0,14" />
                        <ListBox x:Name="ChatList" Grid.Row="2" ItemsSource="{Binding Chats}"
                                 SelectedItem="{Binding SelectedChat, Mode=TwoWay}"
                                 SelectionChanged="ChatList_OnSelectionChanged"
                                 ItemContainerStyle="{StaticResource WorkspaceChatItemStyle}"
                                 BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="#24154C" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Network}" FontSize="12" Foreground="#796C98"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Row="3" CornerRadius="10" Background="#F0E8FF" Padding="12,10">
                            <TextBlock Text="Чаты подключены и история загружена"
                                       TextWrapping="Wrap" Foreground="#654293" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="34,28,34,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Задания" FontWeight="Bold" Foreground="#24154C" FontSize="28" />
                        <TextBlock Text="Предварительно найденные задания из загруженной истории."
                                   Foreground="#796C98" FontSize="14" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#E8DEF5" BorderThickness="0,0,0,1"
                            Margin="0,20,0,16" Padding="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedChatTitle}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="#24154C" />
                            <TextBlock Text="{Binding TaskSummary}" Margin="0,4,0,0"
                                       Foreground="#796C98" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="2">
                        <TextBlock Text="Загружаем список заданий…" Foreground="#796C98"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
                        <TextBlock Text="В выбранном чате пока нет распознанных заданий."
                                   TextWrapping="Wrap" Foreground="#796C98" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasNoTasks, Converter={StaticResource BoolVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasTasks, Converter={StaticResource BoolVisibility}}">
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E5D8F8" BorderThickness="1" CornerRadius="12"
                                                Background="#FCFAFF" Padding="16,14" Margin="0,0,8,12">
                                            <StackPanel>
                                                <TextBlock Text="Задание из Telegram" Foreground="#24154C"
                                                           FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" MaxHeight="130" Margin="0,8,0,10"
                                                           Foreground="#655A7E" FontSize="13" />
                                                <Button Content="Открыть публикацию" Tag="{Binding PostUrl}"
                                                        Click="OpenPostButton_OnClick" HorizontalAlignment="Left"
                                                        Style="{StaticResource WorkspaceOpenLinkButton}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
