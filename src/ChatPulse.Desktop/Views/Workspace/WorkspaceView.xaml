<UserControl x:Class="ChatPulse.Desktop.Views.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ChatPulse.Desktop.Views.Workspace"
             IsVisibleChanged="OnVisibilityChanged"
             FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible" />
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171038" Offset="0" />
            <GradientStop Color="#26144E" Offset="0.6" />
            <GradientStop Color="#401365" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7545F9" Offset="0" />
            <GradientStop Color="#BA35E8" Offset="0.54" />
            <GradientStop Color="#FB239D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E9E1F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style x:Key="SubscriptionPanelCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSubscriptionTableExpanded}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Векторная кнопка: размер и толщина стрелки не зависят от системного шрифта. -->
        <Style x:Key="SidebarToggleButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,30,-16,0" />
            <Setter Property="Background" Value="#493074" />
            <Setter Property="BorderBrush" Value="#8764BB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="Chevron" Data="M 13,4 L 7,10 L 13,16"
                                  Width="20" Height="20" Stretch="None"
                                  Stroke="#FFFFFF" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" RenderTransformOrigin="0.5,0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="›">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="-1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#65409A" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#C096F8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#321D57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Margin" Value="0,28,-16,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#7951B7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Full-surface clickable information cards, independent from action buttons. -->
        <Style x:Key="SubscriptionsInfoCardButton" TargetType="Button">
            <Setter Property="Background" Value="#FAF7FE" />
            <Setter Property="BorderBrush" Value="#E8DBF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F3ECFD" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#D4B9F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EEE4FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceActionButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="Background" Value="#F4EDFF" />
            <Setter Property="Foreground" Value="#6738AE" />
            <Setter Property="BorderBrush" Value="#D8C4F6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.47" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact secondary icon button for checking a single subscription direction. -->
        <Style x:Key="SubscriptionRefreshButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#F5EDFF" />
            <Setter Property="Foreground" Value="#7640B5" />
            <Setter Property="BorderBrush" Value="#E4D4F5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EADCFB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkspaceChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="7,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="10"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#6534A0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#8353B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FeatureTile" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E7DBF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="17" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FeatureSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FeatureSurface" Property="BorderBrush" Value="#AE83EC" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="FeatureSurface" Property="BorderBrush" Value="#7545F9" />
                                <Setter TargetName="FeatureSurface" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubscriptionsFeatureTile" TargetType="Button" BasedOn="{StaticResource FeatureTile}">
            <Setter Property="Background" Value="#FFF4F9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSubscriptionsVisible}" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FBE3F5" Offset="0" />
                                <GradientStop Color="#F4DDFD" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#B944BE" BlurRadius="18" ShadowDepth="0" Opacity="0.22" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Same fixed-length vertical scrollbar mechanism used for the library tables in Mnemora.
             Scoped to the subscriptions DataGrid; other ChatPulse scrollbars are unchanged. -->
        <Style x:Key="SubscriptionScrollPageButton" TargetType="{x:Type RepeatButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SubscriptionScrollThumb" TargetType="{x:Type Thumb}">
            <!-- Height + Track.ViewportSize=NaN keeps the thumb a usable length
                 even in a long participant list. The visible bar remains 4 px wide. -->
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#8753B7" />
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="{TemplateBinding Background}"
                                Margin="4,0" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="#7545F9" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="SubscriptionVerticalScrollBarTemplate"
                         TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <!-- The transparent track and fixed 48px thumb mirror Mnemora. -->
                <Track x:Name="PART_Track" Orientation="Vertical"
                       IsDirectionReversed="True" Margin="2" ViewportSize="NaN">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Style="{StaticResource SubscriptionScrollPageButton}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource SubscriptionScrollThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Style="{StaticResource SubscriptionScrollPageButton}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style x:Key="SubscriptionTableScrollBar"
               TargetType="{x:Type ScrollBar}"
               BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="16" />
                    <Setter Property="MinWidth" Value="16" />
                    <Setter Property="Margin" Value="6,2,2,2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template" Value="{StaticResource SubscriptionVerticalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F7F6FC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Постоянная сворачиваемая навигация. -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid Margin="14,24,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="7,0,0,35">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resources/ChatPulseLogo.png"
                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Width" Value="46" />
                                    <Setter Property="Height" Value="46" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                            <Setter Property="Width" Value="40" />
                                            <Setter Property="Height" Value="40" />
                                             <Setter Property="Margin" Value="-7,0,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="ChatPulse" FontSize="20" FontWeight="Bold" Foreground="White"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>

                </Grid>

                <Button x:Name="HomeButton" Grid.Row="1" Click="HomeButton_OnClick"
                        Style="{StaticResource NavigationButton}" ToolTip="Главная">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⌂" FontSize="25" Width="34" TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="Главная" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Row="2" Text="ЧАТЫ" FontSize="10" FontWeight="SemiBold" Foreground="#BB9CDC"
                           Margin="16,27,0,13"
                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                <ListBox x:Name="ChatList" Grid.Row="3" ItemsSource="{Binding Chats}"
                         SelectedItem="{Binding SelectedChat, Mode=TwoWay}"
                         SelectionChanged="ChatList_OnSelectionChanged"
                         ItemContainerStyle="{StaticResource WorkspaceChatItemStyle}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!-- При свёрнутой панели одинаковый промежуток между иконками навигации. -->
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <Setter Property="Margin" Value="0,4,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}">
                                <Border Width="31" Height="31" Background="#3B256D" CornerRadius="9" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NetworkSymbol}" FontSize="22" Foreground="#F17CCF"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVisible}}">
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold"
                                               FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                               FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="166" />
                                    <TextBlock Text="{Binding Network}" Foreground="#C3B2D9" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Синхронизация вынесена в самостоятельную компактную карточку в подвале навигации. -->
                <Border Grid.Row="4" Margin="0,10,0,3" CornerRadius="12"
                        Background="#342157" BorderBrush="#594078" BorderThickness="1"
                        Padding="5,6,5,7">
                    <StackPanel>
                        <Button Click="CheckReactionsButton_OnClick"
                                Style="{StaticResource NavigationButton}"
                                ToolTip="Синхронизировать все подключённые чаты"
                                IsEnabled="{Binding IsNotBusy}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⟳" FontSize="22" Width="34"
                                           TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="Синхронизировать все" FontWeight="SemiBold"
                                           FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="12,5,9,3"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}">
                            <Border Height="1" Background="#664E81" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding LastAllChatsSyncLabel, Mode=OneWay}"
                                       Foreground="#F4EAFE" FontSize="11"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding LastAllChatsSyncLabel, Mode=OneWay}" />
                            <TextBlock Text="{Binding LastAllChatsSyncNewMessagesLabel, Mode=OneWay}"
                                       Foreground="#D8C5EC" FontSize="11"
                                       TextWrapping="NoWrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="SettingsButton" Grid.Row="5" Click="SettingsButton_OnClick"
                        Style="{StaticResource NavigationButton}" ToolTip="Настройки" Margin="0,6,0,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="21" Width="34" TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="Настройки" VerticalAlignment="Center"
                                   Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisible}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Кнопка на внешней границе боковой панели: не влияет на высоту навигации. -->
        <Button x:Name="CollapseButton" Grid.Column="0" Panel.ZIndex="10"
                Content="‹" Style="{StaticResource SidebarToggleButton}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip="Свернуть или раскрыть панель"
                Click="ToggleSidebarButton_OnClick" />

        <!-- Контент не зависит от состояния бокового меню. -->
        <Grid Grid.Column="1" Margin="34,22,34,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Заголовок выбранной страницы остаётся видимым при прокрутке содержимого. -->
                <Grid Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="Главная" Foreground="#24154C" FontSize="32" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolVisible}}" />
                    <Grid Visibility="{Binding IsChatVisible, Converter={StaticResource BoolVisible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Фирменная иконка выбирается по типу подключённого чата. -->
                        <Grid Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="9">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                    <GradientStop Color="#FEDA75" Offset="0" />
                                                    <GradientStop Color="#FA7E1E" Offset="0.25" />
                                                    <GradientStop Color="#D62976" Offset="0.57" />
                                                    <GradientStop Color="#962FBF" Offset="0.82" />
                                                    <GradientStop Color="#4F5BD5" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChatNetwork}" Value="Instagram">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Margin="5.5">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 8,3.5 H 16 C 18.5,3.5 20.5,5.5 20.5,8 V 16 C 20.5,18.5 18.5,20.5 16,20.5 H 8 C 5.5,20.5 3.5,18.5 3.5,16 V 8 C 3.5,5.5 5.5,3.5 8,3.5 Z"
                                              Fill="Transparent" Stroke="White" StrokeThickness="2.1" StrokeLineJoin="Round" />
                                        <Ellipse Canvas.Left="8.2" Canvas.Top="8.2" Width="7.6" Height="7.6"
                                                 Fill="Transparent" Stroke="White" StrokeThickness="2.1" />
                                        <Ellipse Canvas.Left="16.5" Canvas.Top="6.3" Width="2.1" Height="2.1" Fill="White" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <Border Width="34" Height="34" Background="#229ED9" CornerRadius="17">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedChatNetwork}" Value="Telegram">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Viewbox Margin="5">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 3.4,11.4 L 20.4,4.7 C 21.2,4.4 21.7,4.8 21.5,5.9 L 18.6,19.2 C 18.4,20.1 17.9,20.4 17.1,19.9 L 12.8,16.8 L 10.6,18.9 C 10.2,19.3 9.8,19.1 9.8,18.5 L 9.8,15.3 L 17.7,8.1 C 18.1,7.7 17.7,7.5 17.2,7.8 L 7.6,14.0 L 3.5,12.7 C 2.5,12.4 2.5,11.8 3.4,11.4 Z"
                                              Fill="White" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedChatTitle}" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                       Foreground="#24154C" FontSize="25" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="⟳ Синхронизировать этот чат"
                                        Click="SyncSelectedChatButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}"
                                        IsEnabled="{Binding IsNotBusy}" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding LastSelectedChatSyncLabel, Mode=OneWay}"
                                           Foreground="#786A8B" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Настройки" Foreground="#24154C" FontSize="32" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolVisible}}" />
                </Grid>
                <Border Grid.Column="1" Background="White" CornerRadius="11" BorderBrush="#E8DDF3"
                        BorderThickness="1" Padding="15,10" ToolTip="Автоматическая ежедневная проверка будет реализована позже">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#BA35E8" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Text="Ежедневная проверка · в разработке" Foreground="#65547D"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Главная: используем только реально прочитанные данные. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolVisible}}">
                <StackPanel Margin="0,0,10,15">
                    <TextBlock Text="Обзор подключённых чатов и найденных заданий"
                               FontSize="14" Foreground="#837397" Margin="0,0,0,24" />

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PanelCard}" Margin="0,0,10,0" MinHeight="128">
                            <StackPanel>
                                <TextBlock Text="Найдено заданий" Foreground="#74658B" FontSize="13" />
                                <TextBlock Text="{Binding TotalDetected}" Foreground="#24154C" FontWeight="Bold" FontSize="30" Margin="0,8,0,2" />
                                <TextBlock Text="По загруженной истории" Foreground="#9385A8" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource PanelCard}" Margin="5,0" MinHeight="128">
                            <StackPanel>
                                <TextBlock Text="Подключено чатов" Foreground="#74658B" FontSize="13" />
                                <TextBlock Text="{Binding ConnectedChatCount}" Foreground="#24154C" FontWeight="Bold" FontSize="30" Margin="0,8,0,2" />
                                <TextBlock Text="С загруженной историей" Foreground="#9385A8" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource PanelCard}" Margin="10,0,0,0" MinHeight="128">
                            <StackPanel>
                                <TextBlock Text="Выполнено сегодня" Foreground="#74658B" FontSize="13" />
                                <TextBlock Text="—" Foreground="#24154C" FontWeight="Bold" FontSize="30" Margin="0,8,0,2" />
                                <TextBlock Text="Учёт пока не подключён" Foreground="#9385A8" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Прогресс выполнения" Foreground="#24154C" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Появится после реализации отметок «Готово» и проверки выполнения."
                                       Foreground="#81718F" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,14" />
                            <Border Height="9" Background="#F0E9FA" CornerRadius="5" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="По чатам" Foreground="#24154C" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,13" />
                            <ItemsControl ItemsSource="{Binding Chats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F0E8F6" BorderThickness="0,0,0,1" Padding="0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NetworkSymbol}" FontSize="24" Foreground="#A242E6" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="#24154C" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Network}" FontSize="11" Foreground="#827393" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DetectedLabel}" Foreground="#72638A"
                                                           FontSize="12" VerticalAlignment="Center" Margin="6,0,14,0" />
                                                <Button Grid.Column="3" Content="Открыть" Tag="{Binding}"
                                                        Click="OpenChatButton_OnClick" Style="{StaticResource WorkspaceActionButton}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LoadMessage}" FontSize="12" Foreground="#8C6DAB" Margin="0,14,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Background="#F5EDFF">
                        <StackPanel>
                            <TextBlock Text="Дальше в ChatPulse" Foreground="#24154C" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Отметки выполнения, проверка подписок и ежедневный аудит будут добавлены по мере разработки."
                                       Foreground="#71628A" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Плитки чата закреплены над прокручиваемым списком заданий. -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsChatVisible, Converter={StaticResource BoolVisible}}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0,16,10,18" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSubscriptionTableExpanded}" Value="True">
                                <Setter Property="Margin" Value="0,6,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,22">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSubscriptionTableExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="TasksTabButton_OnClick" Margin="0,0,10,0"
                                Tag="{Binding IsTasksVisible}" Style="{StaticResource FeatureTile}" Background="#F1E8FF" MinHeight="166">
                            <StackPanel>
                                <TextBlock Text="▤  Задания" FontSize="15" FontWeight="SemiBold" Foreground="#693BBA" />
                                <TextBlock Text="{Binding SelectedChatTaskCount}" FontSize="29" FontWeight="Bold" Foreground="#24154C" Margin="0,9,0,1" />
                                <TextBlock Text="Предварительно найдено" Foreground="#827092" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Click="SubscriptionsTabButton_OnClick" Margin="5,0"
                                Tag="{Binding IsSubscriptionsVisible}" Style="{StaticResource SubscriptionsFeatureTile}" MinHeight="166">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="♡  Подписки" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#AF328E" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                                    <TextBlock Text="{Binding SubscriptionCountLabel}" FontSize="28" FontWeight="Bold"
                                               Foreground="#24154C" VerticalAlignment="Bottom" />
                                    <TextBlock Text="участниц" FontSize="12" Foreground="#827092"
                                               Margin="8,0,0,5" VerticalAlignment="Bottom" />
                                </StackPanel>

                                <Border Grid.Row="2" Height="1" Background="#E9D8F0"
                                        Margin="0,10,0,9" />

                                <!-- One participant belongs to exactly one category. -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17" Height="17" Stretch="Uniform" Fill="Transparent"
                                                  Stroke="#A24BA4" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round" VerticalAlignment="Center"
                                                  Data="M 12,2 L 20,5 V 11 C 20,16 16.5,20 12,22 C 7.5,20 4,16 4,11 V 5 Z" />
                                            <TextBlock Text="{Binding SubscriptionAdministrationCountLabel}" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="#24154C"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Админы" FontSize="10" Foreground="#827092"
                                                   TextWrapping="NoWrap" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17" Height="17" Stretch="Uniform" Fill="Transparent"
                                                  Stroke="#BA4F99" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center"
                                                  Data="M 2,7 L 7,12 L 12,5 L 17,12 L 22,7 L 20,19 H 4 Z M 4,22 H 20" />
                                            <TextBlock Text="{Binding SubscriptionVipCountLabel}" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="#24154C"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="VIP" FontSize="10" Foreground="#827092"
                                                   TextWrapping="NoWrap" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="17" Height="17" Stretch="Uniform" Fill="Transparent"
                                                  Stroke="#8650C5" StrokeThickness="1.8" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  VerticalAlignment="Center"
                                                  Data="M 12,4 A 4,4 0 1 1 11.99,4 M 4,21 C 4,17 7,15 12,15 C 17,15 20,17 20,21" />
                                            <TextBlock Text="{Binding SubscriptionRegularCountLabel}" FontSize="18"
                                                       FontWeight="SemiBold" Foreground="#24154C"
                                                       Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Обычные" FontSize="10" Foreground="#827092"
                                                   TextWrapping="NoWrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Button>
                        <Button Grid.Column="2" Click="MyActivityTabButton_OnClick" Margin="10,0,0,0"
                                Tag="{Binding IsMyActivityVisible}" Style="{StaticResource FeatureTile}" Background="#F6F0FF" MinHeight="166">
                            <StackPanel>
                                <TextBlock Text="◌  Мой актив" FontSize="15" FontWeight="SemiBold" Foreground="#7545B9" />
                                <TextBlock Text="—" FontSize="29" FontWeight="Bold" Foreground="#24154C" Margin="0,9,0,1" />
                                <TextBlock Text="Мои публикации и задания" Foreground="#827092" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource PanelCard}"
                            Visibility="{Binding IsTasksVisible, Converter={StaticResource BoolVisible}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Задания" Foreground="#24154C" FontSize="21" FontWeight="Bold" />
                            <TextBlock Grid.Row="1" Text="{Binding TaskSummary}" Foreground="#81718F" FontSize="12" Margin="0,6,0,14"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                                <Button x:Name="DetectedFilterButton" Content="Невыполненные" Click="DetectedFilterButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Margin="0,0,8,0"
                                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
                                <Button x:Name="CompletedFilterButton" Content="Выполненные" Click="CompletedFilterButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Opacity="0.6" Margin="0,0,8,0" />
                                <Button x:Name="SkippedFilterButton" Content="Пропущенные" Click="SkippedFilterButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Opacity="0.6" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="Загружаем задания…" Foreground="#876FA0" FontSize="13"
                                               HorizontalAlignment="Center" Margin="0,25"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolVisible}}" />
                                    <TextBlock Text="{Binding EmptyTasksMessage}" Foreground="#827393" FontSize="13"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,30"
                                               Visibility="{Binding HasNoTasks, Converter={StaticResource BoolVisible}}" />
                                    <ItemsControl ItemsSource="{Binding Tasks}"
                                                  Visibility="{Binding HasTasks, Converter={StaticResource BoolVisible}}">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,12,0,15">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Height="1" Background="#E6DDED" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Background="#F5F0FB" CornerRadius="12" Padding="13,5" Margin="11,0">
                                                                <TextBlock Text="{Binding Name}" Foreground="#735C86"
                                                                           FontSize="12" FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Grid.Column="2" Height="1" Background="#E6DDED" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{Binding CardBorderBrush, Mode=OneWay}" BorderThickness="1"
                                                        Background="{Binding CardBackground, Mode=OneWay}"
                                                        CornerRadius="12" Margin="0,0,0,10" Padding="15,13">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Подписка и отписка: метка и ссылки слева, действия справа, одна строка. -->
                                                        <WrapPanel Grid.Row="0" Grid.Column="0" Margin="7,0,12,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsSubscriptionAction, Converter={StaticResource BoolVisible}}">
                                                            <Border Background="{Binding KindBackground, Mode=OneWay}"
                                                                    CornerRadius="8" Padding="10,5"
                                                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding KindLabel, Mode=OneWay}"
                                                                           Foreground="{Binding KindForeground, Mode=OneWay}"
                                                                           FontSize="12" FontWeight="SemiBold" />
                                                            </Border>
                                                            <ItemsControl ItemsSource="{Binding ActionLinks, Mode=OneWay}"
                                                                          VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding Text}" Tag="{Binding Url}"
                                                                                Margin="0,0,6,0"
                                                                                Click="OpenPostButton_OnClick"
                                                                                Style="{StaticResource WorkspaceActionButton}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>
                                                        <Grid Grid.Row="0" Grid.ColumnSpan="2"
                                                              Visibility="{Binding IsRegularTask, Converter={StaticResource BoolVisible}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="34" Height="34" Background="#F0E5FF" CornerRadius="10"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="▤" FontSize="19" Foreground="#9152D5"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                         <Border Background="{Binding KindBackground}" CornerRadius="8"
                                                                                 Padding="9,4" Margin="0,0,10,0">
                                                                             <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                                                        FontWeight="SemiBold" Foreground="{Binding KindForeground}" />
                                                                         </Border>
                                                                         <TextBlock Text="{Binding Title}" Foreground="#24154C"
                                                                                    FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                                                    FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                    Margin="0,0,12,0" />
                                                                         <Button Content="↗  Reel" Tag="{Binding ReelUrl}"
                                                                                 Visibility="{Binding HasReelUrl, Converter={StaticResource BoolVisible}}"
                                                                                 Click="OpenPostButton_OnClick" Style="{StaticResource WorkspaceActionButton}"
                                                                                 Margin="0,0,8,0" />
                                                                         <TextBlock Text="или" Foreground="#9280A7" VerticalAlignment="Center"
                                                                                    Visibility="{Binding HasBothInstagramLinks, Converter={StaticResource BoolVisible}}"
                                                                                    Margin="0,0,8,0" />
                                                                         <Button Content="↗  Пост" Tag="{Binding FeedPostUrl}"
                                                                                 Visibility="{Binding HasFeedPostUrl, Converter={StaticResource BoolVisible}}"
                                                                                 Click="OpenPostButton_OnClick" Style="{StaticResource WorkspaceActionButton}" />
                                                                     </WrapPanel>
                                                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" Foreground="#93849F"
                                                                               FontSize="12" Margin="12,0,0,0" />
                                                                </Grid>
                                                                <TextBlock local:CustomEmojiText.Text="{Binding Description}"
                                                                           local:CustomEmojiText.Entities="{Binding CustomEmojiJson}"
                                                                           Foreground="#80708E"
                                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                                           FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Grid.Row" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSubscriptionAction}" Value="True">
                                                                            <Setter Property="Grid.Row" Value="0" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Button Content="↗  Задание" Tag="{Binding SourceUrl}"
                                                                    IsEnabled="{Binding HasSourceUrl}"
                                                                    Click="OpenPostButton_OnClick" Style="{StaticResource WorkspaceActionButton}"
                                                                    Margin="0,0,9,0" />
                                                            <Button Content="↗  Пост" Tag="{Binding PostUrl}"
                                                                    Visibility="{Binding HasStandalonePostUrl, Converter={StaticResource BoolVisible}}"
                                                                    Click="OpenPostButton_OnClick" Style="{StaticResource WorkspaceActionButton}"
                                                                    Margin="0,0,9,0" />
                                                            <Button Content="Пропустить" Tag="{Binding MessageId}"
                                                                    Visibility="{Binding CanSkip, Converter={StaticResource BoolVisible}}"
                                                                    Click="SkipTaskButton_OnClick" Style="{StaticResource WorkspaceActionButton}"
                                                                    Margin="0,0,9,0" />
                                                             <Button Content="Удалить" Tag="{Binding MessageId}"
                                                                     Visibility="{Binding CanHideCompleted, Converter={StaticResource BoolVisible}}"
                                                                     Click="HideCompletedTaskButton_OnClick" Style="{StaticResource WorkspaceActionButton}"
                                                                     Background="#BB496A" Foreground="White" BorderThickness="0"
                                                                     Margin="0,0,9,0" />
                                                            <Button Content="Вернуть в задания" Tag="{Binding MessageId}"
                                                                    Visibility="{Binding IsSkipped, Converter={StaticResource BoolVisible}}"
                                                                    Click="RestoreTaskButton_OnClick" Style="{StaticResource WorkspaceActionButton}"
                                                                    Margin="0,0,9,0" />
                                                            <Button Content="✓  Готово" Tag="{Binding MessageId}"
                                                                    Visibility="{Binding CanComplete, Converter={StaticResource BoolVisible}}"
                                                                    Click="CompleteTaskButton_OnClick"
                                                                    Style="{StaticResource WorkspaceActionButton}"
                                                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                                                    BorderThickness="0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Show the current chat's register including VIP/admin; only owner profiles are excluded.
                         Subscription checks can be started and stopped directly from this tab. -->
                    <!-- Only the DataGrid scrolls vertically. The surrounding cards and filters stay fixed. -->
                    <Border Grid.Row="1" Style="{StaticResource SubscriptionPanelCard}"
                            Visibility="{Binding IsSubscriptionsVisible, Converter={StaticResource BoolVisible}}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- Information and actions are grouped by purpose; detail buttons do not start checks. -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSubscriptionTableExpanded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Margin="0,0,7,0" MinHeight="142"
                                        Background="#FAF7FE" BorderBrush="#E8DBF5"
                                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Margin="0,0,0,8"
                                                Style="{StaticResource SubscriptionsInfoCardButton}"
                                                Padding="0" Background="Transparent" BorderThickness="0"
                                                Click="ShowLastInstagramCheckDetails_OnClick"
                                                ToolTip="Открыть отчёт последней успешной проверки">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="♡" FontSize="18" Foreground="#8B42CF"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Проверка подписок" FontSize="14"
                                                               FontWeight="SemiBold" Foreground="#39295F"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LatestCheckDateLabel, Mode=OneWay}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#4F3D72" />
                                                <TextBlock Text="{Binding LatestCheckCountsLabel, Mode=OneWay}"
                                                           Foreground="#827393" FontSize="11" TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="Требуется проверка подписок"
                                                           Foreground="#9B6118" FontWeight="SemiBold"
                                                           FontSize="11" Margin="0,6,0,0"
                                                           ToolTip="Состав участниц или проверяемые профили изменились после последней успешной массовой проверки."
                                                           Visibility="{Binding IsSubscriptionReviewRequired, Mode=OneWay, Converter={StaticResource BoolVisible}}" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Отчёт" Height="34" Margin="0,0,8,0"
                                                    Style="{StaticResource WorkspaceActionButton}"
                                                    Click="ShowLastInstagramCheckDetails_OnClick"
                                                    ToolTip="Посмотреть результаты последней успешной проверки" />
                                            <Button Content="Проверить" Height="34"
                                                    Style="{StaticResource WorkspaceActionButton}"
                                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                                    BorderThickness="0" IsEnabled="{Binding CanUseInstagram}"
                                                    Click="CheckAllInstagramParticipantsButton_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Margin="7,0,0,0" MinHeight="142"
                                        Background="#FAF7FE" BorderBrush="#E8DBF5"
                                        BorderThickness="1" CornerRadius="12" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Margin="0,0,0,8"
                                                Style="{StaticResource SubscriptionsInfoCardButton}"
                                                Padding="0" Background="Transparent" BorderThickness="0"
                                                Click="ShowParticipantListDetails_OnClick"
                                                ToolTip="Посмотреть сведения о последнем списке Telegram">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="↻" FontSize="17" Foreground="#8B42CF"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="Список участниц" FontSize="14"
                                                               FontWeight="SemiBold" Foreground="#39295F"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ParticipantListMessageDateLabel, Mode=OneWay}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#4F3D72" />
                                                <TextBlock Text="{Binding ParticipantLastSyncLabel, Mode=OneWay}"
                                                           Foreground="#827393" FontSize="11" TextWrapping="Wrap"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="Отчёт" Height="34" Margin="0,0,8,0"
                                                    Style="{StaticResource WorkspaceActionButton}"
                                                    Click="ShowParticipantListDetails_OnClick"
                                                    ToolTip="Открыть отчёт по актуальному списку участниц" />
                                            <Button Content="Синхронизировать" Height="34"
                                                    Style="{StaticResource WorkspaceActionButton}"
                                                    Background="{StaticResource AccentBrush}" Foreground="White"
                                                    BorderThickness="0" IsEnabled="{Binding IsNotBusy}"
                                                    Click="RefreshSubscriptionsButton_OnClick" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <!-- Filtering works independently of the check and synchronization actions above. -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Расхождения"
                                          IsChecked="{Binding ShowOnlySubscriptionDiscrepancies, Mode=TwoWay}"
                                          Foreground="#39295F" FontSize="12" FontWeight="SemiBold"
                                          VerticalAlignment="Center" Margin="0,0,18,0"
                                          ToolTip="Показать только участниц с расхождениями; без отметки — всех" />
                                <Border Grid.Column="1" MinWidth="180"
                                        HorizontalAlignment="Stretch" Background="#FCFAFF" BorderBrush="#DED0EE"
                                        BorderThickness="1" CornerRadius="10" Padding="11,4" MinHeight="44">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="23" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M 11,3 A 8,8 0 1 1 10.99,3 M 17.5,17.5 L 23,23"
                                              Width="17" Height="17" Stroke="#967CAD" StrokeThickness="2"
                                              Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                        <TextBox x:Name="SubscriptionSearchBox" Grid.Column="1"
                                                 Text="{Binding SubscriptionQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 VerticalContentAlignment="Center" FontSize="12"
                                                 Foreground="#38245D" MinHeight="26"
                                                 ToolTip="Поиск по имени, категории или Instagram username" />
                                        <TextBlock Grid.Column="1" Text="Поиск участниц" IsHitTestVisible="False"
                                                   Foreground="#9181A3" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SubscriptionQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SubscriptionQuery}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <!-- One compact vector icon toggles between maximize and restore. -->
                                <Button Grid.Column="2"
                                        Click="ToggleSubscriptionTableExpansionButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}"
                                        Height="44" Width="44" Margin="12,0,0,0" Padding="0"
                                        ToolTip="{Binding SubscriptionTableExpandLabel}"
                                        AutomationProperties.Name="{Binding SubscriptionTableExpandLabel}">
                                    <Path Width="21" Height="21" Stretch="Uniform"
                                          Stroke="#7640B5" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" Fill="Transparent">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <!-- Maximize: four outward-facing corners. -->
                                                <Setter Property="Data" Value="M 9,3 L 3,3 L 3,9 M 15,3 L 21,3 L 21,9 M 21,15 L 21,21 L 15,21 M 9,21 L 3,21 L 3,15" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubscriptionTableExpanded}" Value="True">
                                                        <!-- Restore: four corners turned toward the center. -->
                                                        <Setter Property="Data" Value="M 3,9 L 9,9 L 9,3 M 21,9 L 15,9 L 15,3 M 15,21 L 15,15 L 21,15 M 3,15 L 9,15 L 9,21" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </Grid>
                            <Border Grid.Row="2" Background="#EAE1F1" Height="1"
                                    Margin="0,0,0,13" />
                            <!-- Mnemora's table frame: rounded clipped surface and a fixed header filler
                                 over the scroll bar gutter. The only scrolling region remains the DataGrid. -->
                            <Border Grid.Row="3" MinHeight="0"
                                    Background="White" BorderBrush="#E6DAF1" BorderThickness="1"
                                    CornerRadius="12" ClipToBounds="True">
                                <!-- Border.CornerRadius does not clip child visuals in WPF.
                                     Keep the grid's clip in sync with its actual size so both
                                     the header's top corners and lower table corners are rounded. -->
                                <Grid ClipToBounds="True"
                                      SizeChanged="SubscriptionTableSurface_OnSizeChanged">
                                    <DataGrid x:Name="SubscriptionDataGrid" MinHeight="0"
                                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ItemsSource="{Binding SubscriptionRowsView}"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              CanUserResizeRows="False" HeadersVisibility="Column"
                                              EnableRowVirtualization="True"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8DEF1"
                                              BorderThickness="0" Background="Transparent"
                                              AlternatingRowBackground="#FCFAFF" RowBackground="White"
                                              SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Resources>
                                        <!-- Use the Mnemora-style fixed-length thumb in this table only. -->
                                        <Style TargetType="{x:Type ScrollBar}"
                                               BasedOn="{StaticResource SubscriptionTableScrollBar}" />
                                    </DataGrid.Resources>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Height" Value="48" />
                                        <Setter Property="Padding" Value="12,0" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Background" Value="#F8F4FD" />
                                        <Setter Property="Foreground" Value="#5C4A74" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="#E8DEF1" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Участница" Width="13*" MinWidth="145">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,6">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                               Foreground="#24154C" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Category}" Foreground="#78638A"
                                                               FontSize="11" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Профиль" Width="22*" MinWidth="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,6">
                                                    <TextBlock TextWrapping="Wrap" Foreground="#6239A2">
                                                        <Hyperlink NavigateUri="{Binding ProfileActionUri, Mode=OneWay}"
                                                                   IsEnabled="{Binding CanOpenProfile, Mode=OneWay}"
                                                                   RequestNavigate="OpenParticipantProfileLink_OnRequestNavigate"
                                                                   ToolTip="Открыть профиль в Instagram"
                                                                   Foreground="#6239A2">
                                                            <Run Text="{Binding ProfileUserNameLabel, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="#8A409F"
                                                               Visibility="{Binding HasDifferentActivityProfile, Converter={StaticResource BoolVisible}}">
                                                        <Run Text="Даёт актив с другой страницы: " />
                                                        <Hyperlink NavigateUri="{Binding ActivityProfileUri, Mode=OneWay}"
                                                                   RequestNavigate="OpenParticipantProfileLink_OnRequestNavigate"
                                                                   ToolTip="Открыть профиль для актива"
                                                                   Foreground="#8A409F">
                                                            <Run Text="{Binding ActivityUserNameLabel, Mode=OneWay}" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Я подписана" Width="16*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,4">
                                                <TextBlock Text="{Binding IFollowLabel}" TextWrapping="Wrap" Margin="3,4"
                                                           VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#78658A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IFollowStatus}" Value="FOUND">
                                                                    <Setter Property="Foreground" Value="#248357" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IFollowStatus}" Value="NOT_FOUND">
                                                                    <Setter Property="Foreground" Value="#B42A54" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="↻" Margin="6,0,0,0"
                                                        ToolTip="Проверить мою подписку на профиль для подписки"
                                                        Tag="{Binding}" Click="CheckRowIFollowButton_OnClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SubscriptionRefreshButton}">
                                                            <Setter Property="IsEnabled" Value="{Binding CanCheckFollowing}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.CanUseInstagram, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Подписана на меня" Width="16*" MinWidth="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,4">
                                                <TextBlock Text="{Binding FollowsMeLabel}" TextWrapping="Wrap" Margin="3,4"
                                                           VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#78658A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FollowsMeStatus}" Value="FOUND">
                                                                    <Setter Property="Foreground" Value="#248357" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowsMeStatus}" Value="NOT_FOUND">
                                                                    <Setter Property="Foreground" Value="#B42A54" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Content="↻" Margin="6,0,0,0"
                                                        ToolTip="Проверить подписку участницы на меня"
                                                        Tag="{Binding}" Click="CheckRowFollowsMeButton_OnClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SubscriptionRefreshButton}">
                                                            <Setter Property="IsEnabled" Value="{Binding CanCheckFollowers}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FollowsMeStatus}" Value="NOT_APPLICABLE">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.CanUseInstagram, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Обновлено" Width="12*" MinWidth="142">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LastCheck}" Margin="10,6"
                                                           Foreground="#827393" FontSize="11"
                                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                    </DataGrid>
                                    <!-- Same 24px top-right filler used by Mnemora's library tables. -->
                                    <Border Panel.ZIndex="20"
                                            Width="24" Height="48"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#F8F4FD" BorderBrush="#E8DEF1"
                                            BorderThickness="0,0,0,1" CornerRadius="0,11,0,0"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource PanelCard}"
                            Visibility="{Binding IsMyActivityVisible, Converter={StaticResource BoolVisible}}">
                        <StackPanel>
                            <TextBlock Text="Мой актив" Foreground="#24154C" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="Здесь появятся мои публикации и задания, на которые участницы дают актив."
                                       Margin="0,11,0,8" Foreground="#766787" FontSize="14" TextWrapping="Wrap" />
                            <TextBlock Text="Учёт собственного актива добавим отдельно" Foreground="#B039A6" FontSize="12" />
                        </StackPanel>
                    </Border>
            </Grid>

            <!-- Настройки — визуальный каркас, без ложного подключения чатов. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolVisible}}">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Управление ChatPulse" Foreground="#837397" FontSize="14" Margin="0,5,0,24" />
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Instagram-аккаунты" FontSize="18" FontWeight="SemiBold" Foreground="#24154C" />
                            <TextBlock Text="Мой основной профиль — получаю актив и проверяю подписки" Foreground="#655478"
                                       Margin="0,14,0,5" />
                            <TextBox x:Name="InstagramTargetBox" FontSize="14" Padding="10,8"
                                     ToolTip="Имя профиля без @" />
                            <TextBlock Text="Резервный профиль — могу давать актив с другой страницы (необязательно)"
                                       Foreground="#655478" Margin="0,14,0,5" TextWrapping="Wrap" />
                            <TextBox x:Name="InstagramGiveFromBox" FontSize="14" Padding="10,8"
                                     ToolTip="Можно оставить пустым. Имя профиля без @" />
                            <TextBlock Text="Аккаунт Selenium — только для автоматической проверки (основной или запасной)"
                                       Foreground="#655478" Margin="0,14,0,5" TextWrapping="Wrap" />
                            <TextBox x:Name="InstagramBrowserBox" FontSize="14" Padding="10,8"
                                     ToolTip="Имя профиля без @" />
                            <TextBlock Text="Собственные профили сохраняются в SQLite. Аккаунт Selenium не переключается при смене резервного профиля. Вход выполняется вручную в отдельном Chrome, пароль не сохраняется."
                                       Foreground="#81718F" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,12" />
                            <WrapPanel>
                                <Button Content="Сохранить" Click="SaveInstagramButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanUseInstagram}" />
                                <Button Content="Открыть Instagram" Click="InstagramLoginButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanUseInstagram}" />
                                <Button Content="Проверить сессию" Click="CheckInstagramButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanUseInstagram}" />

                                <Button Content="Сбросить сессию" Click="ResetInstagramButton_OnClick"
                                        Style="{StaticResource WorkspaceActionButton}" Margin="0,0,8,8"
                                        IsEnabled="{Binding CanUseInstagram}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Проверка подписок" FontSize="18" FontWeight="SemiBold" Foreground="#24154C" />
                            <TextBlock Text="Массовая проверка запускается на вкладке «Подписки»; здесь можно проверить одну участницу."
                                       Foreground="#81718F" Margin="0,9,0,12" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="Проверка одной участницы (аккаунт, с которого она даёт актив)"
                                       Foreground="#655478" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding InstagramParticipants}"
                                      SelectedItem="{Binding SelectedInstagramParticipant, Mode=TwoWay}"
                                      DisplayMemberPath="Label" MinHeight="36"
                                      IsEnabled="{Binding CanUseInstagram}" />
                            <Button Content="Проверить подписки участницы"
                                    Click="CheckInstagramParticipantButton_OnClick"
                                    Style="{StaticResource WorkspaceActionButton}" Margin="0,10,0,8"
                                    HorizontalAlignment="Left" IsEnabled="{Binding CanUseInstagram}" />
                            <TextBlock Text="{Binding InstagramStatus}" TextWrapping="Wrap"
                                       Foreground="#75499F" FontSize="12" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="История участниц" FontSize="18" FontWeight="SemiBold"
                                       Foreground="#24154C" />
                            <TextBlock Text="Повторно получить все доступные списки Telegram за весь период и восстановить историю выбытий, возвращений, выходных и штрафных дней."
                                       Foreground="#81718F" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,12" />
                            <TextBlock Text="Telegram-чат" Foreground="#655478" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding Chats}" DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedHistoryChat, Mode=TwoWay}"
                                      SelectionChanged="ParticipantHistoryChat_OnSelectionChanged"
                                      MinHeight="36" />
                            <TextBlock Text="{Binding ParticipantHistoryRulesHint}" FontSize="12"
                                       Foreground="#827393" TextWrapping="Wrap" Margin="0,8,0,12" />
                            <Button Content="Обновить список участниц за весь период"
                                    Click="RebuildParticipantHistoryButton_OnClick"
                                    Style="{StaticResource WorkspaceActionButton}"
                                    IsEnabled="{Binding CanRebuildParticipantHistory}"
                                    HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding ParticipantHistoryLastReport}" FontSize="12"
                                       Foreground="#75499F" TextWrapping="Wrap" Margin="0,7,0,0" />
                            <TextBlock Text="Восстановление истории не меняет последнюю версию списка на вкладке «Подписки» и не затрагивает задания."
                                       FontSize="11" Foreground="#827393" TextWrapping="Wrap" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Подключённые чаты" FontSize="18" FontWeight="SemiBold" Foreground="#24154C" />
                            <TextBlock Text="{Binding ConnectedChatCount, StringFormat='Сейчас подключено: {0}'}"
                                       Foreground="#75499F" Margin="0,9,0,6" FontSize="14" />
                            <TextBlock Text="Выберите новый постчат Telegram. Соцсеть определяется автоматически по сообщениям с Instagram-публикациями; сообщения без ссылок не считаются заданиями."
                                       Foreground="#81718F" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" />
                            <Button Content="Подключить Instagram-чат"
                                    Click="ConnectInstagramChatButton_OnClick"
                                    Style="{StaticResource WorkspaceActionButton}"
                                    HorizontalAlignment="Left" IsEnabled="{Binding IsNotBusy}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="Ежедневная проверка" FontSize="18" FontWeight="SemiBold" Foreground="#24154C" />
                            <TextBlock Text="Автоматическая проверка и ограниченный ручной повтор будут настроены после реализации основной логики."
                                       Foreground="#81718F" Margin="0,9,0,0" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Загружает новые сообщения от последней подтверждённой реакции и обновляет ранее найденные задания. Ежедневный аудит будет реализован позднее."
                                       Foreground="#81718F" Margin="0,9,0,12" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="Синхронизация всех чатов доступна в левом меню над настройками; отдельно выбранный чат можно обновить под его названием."
                                       Foreground="#81718F" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
