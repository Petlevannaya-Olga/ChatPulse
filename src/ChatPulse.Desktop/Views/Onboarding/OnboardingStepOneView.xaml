<UserControl x:Class="ChatPulse.Desktop.Views.Onboarding.OnboardingStepOneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Палитра приветственного экрана ChatPulse. -->
        <LinearGradientBrush x:Key="OnboardingBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.48" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#24154C" />
        <SolidColorBrush x:Key="TextSecondary" Color="#796C98" />

        <!-- Поле ввода: высота и типографика по образцу ProfileSetupView Mnemora. -->
        <Style x:Key="ProfileTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0,46,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8CCED" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CaretBrush" Value="#874DE9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#874DE9" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsNameInvalid}" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#D0446A" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBackButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F4EFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContinueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9"
                                Background="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#B9B0CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OnboardingBackgroundBrush}" ClipToBounds="True">
        <!-- Компактная разметка: при минимальном размере окна 1000×650
             карточка и кнопки полностью помещаются без прокрутки. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Декорации используют тот же холст 1600x900, что в Mnemora. -->
        <Viewbox Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1600" Height="900">
                <Ellipse Width="690" Height="690" Canvas.Left="1120" Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#48AE61F3" />
                            <GradientStop Offset="1" Color="#00AE61F3" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620" Canvas.Left="-280" Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#366C46E7" />
                            <GradientStop Offset="1" Color="#006C46E7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280 M92,254 L48,350 L142,402 M236,312 L290,390 L374,420"
                      Stroke="#A569F1" StrokeThickness="1.2" Opacity="0.2" />
                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178 M1342,164 L1310,252 L1390,302 M1495,214 L1450,322 L1554,380 L1600,350"
                      Stroke="#C46CFF" StrokeThickness="1.2" Opacity="0.22" />
                <Ellipse Width="8" Height="8" Canvas.Left="88" Canvas.Top="250" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="232" Canvas.Top="308" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1338" Canvas.Top="160" Fill="#C46CFF" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1491" Canvas.Top="210" Fill="#C46CFF" Opacity="0.5" />
            </Canvas>
        </Viewbox>

        <!-- Чёткий PNG-логотип для интерфейса; .ico остаётся иконкой окна/EXE. -->
        <Grid Grid.Row="0" Width="350" Height="74" Margin="28,6,28,0"
              HorizontalAlignment="Left">
            <Image Source="pack://application:,,,/Resources/ChatPulseLogo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Width="64" Height="64" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Stretch="Uniform" />
            <StackPanel Margin="76,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold">
                    <Run Text="Chat" Foreground="White" /><Run Text="Pulse" Foreground="#F251D2" />
                </TextBlock>
                <TextBlock Text="Пульс ваших чатов" Foreground="#E4DEFF" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Верхний указатель из трёх шагов по образцу Mnemora. -->
        <Grid Grid.Row="1" MaxWidth="610" Height="64"
              HorizontalAlignment="Stretch" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="1" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Height="3" CornerRadius="2"
                    Background="#75539C" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                    BorderBrush="#75539C" BorderThickness="2" HorizontalAlignment="Center">
                <TextBlock Text="2" Foreground="#C9B9E5" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="3" Height="3" CornerRadius="2"
                    Background="#75539C" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="4" Width="40" Height="40" CornerRadius="20"
                    BorderBrush="#75539C" BorderThickness="2" HorizontalAlignment="Center">
                <TextBlock Text="3" Foreground="#C9B9E5" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="О себе" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Telegram" Foreground="#C9B9E5"
                       FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Первый чат" Foreground="#C9B9E5"
                       FontSize="14" TextAlignment="Center" />
        </Grid>

        <!-- Карточка и подпись шага образуют единый центрированный блок. -->
        <Grid Grid.Row="2" Margin="40,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MaxWidth="720" Height="384" Margin="0,8,0,0"
                    Background="White" CornerRadius="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#10052B" BlurRadius="28" ShadowDepth="8" Opacity="0.3" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="48,20,48,0">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse Fill="#F5EEFF" Stroke="#A74BF0" StrokeThickness="2.5" />
                            <!-- Пока имя не введено — нейтральная иконка пользователя вместо «?». -->
                            <Viewbox Width="39" Height="39" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding IsNameEmpty, Converter={StaticResource BoolToVisibility}}">
                                <Canvas Width="48" Height="48">
                                    <Ellipse Canvas.Left="18" Canvas.Top="8" Width="12" Height="12"
                                             Stroke="#8241D8" StrokeThickness="2.8" Fill="Transparent" />
                                    <Path Data="M 9,40 C 9,30 15,25 24,25 C 33,25 39,30 39,40"
                                          Stroke="#8241D8" StrokeThickness="2.8" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                            <!-- После ввода имени показываем его первую букву, как раньше. -->
                            <TextBlock Text="{Binding AvatarInitial}" FontSize="40" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Оптическое центрирование буквы: базовая линия шрифта
                                     визуально смещает её ниже центра круга. -->
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="-3" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNameEmpty}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="Давайте познакомимся" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextAlignment="Center"
                                   Margin="0,18,0,0" />
                        <TextBlock Text="Как к вам обращаться в ChatPulse?" FontSize="17"
                                   Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                   Margin="0,4,0,0" />
                        <Grid Margin="0,18,0,0">
                            <TextBox x:Name="NameInput"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="50" Style="{StaticResource ProfileTextBox}" />
                            <!-- Подсказка видна только в пустом НЕактивном поле.
                                 Когда TextBox получает фокус, скрываем подсказку,
                                 чтобы каретка не накладывалась на буквы. -->
                            <TextBlock Text="Введите имя" Margin="12,0,0,0" FontSize="18"
                                       Foreground="#ADA0C7" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNameEmpty}" Value="True" />
                                                    <Condition Binding="{Binding ElementName=NameInput, Path=IsKeyboardFocused}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="✓" FontSize="22" FontWeight="Bold"
                                       Foreground="#20A96A" Margin="0,0,18,0" IsHitTestVisible="False"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding IsNameValid, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="!" FontSize="22" FontWeight="Bold"
                                       Foreground="#D0446A" Margin="0,0,18,0" IsHitTestVisible="False"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding IsNameInvalid, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="{Binding ValidationMessage}" FontSize="12" Foreground="#D0446A"
                                   Visibility="{Binding IsNameInvalid, Converter={StaticResource BoolToVisibility}}"
                                   Margin="3,5,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Grid Width="15" Height="15" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource TextSecondary}" StrokeThickness="1.3" />
                                <TextBlock Text="i" FontFamily="Segoe UI" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Имя используется только внутри ChatPulse"
                                       Foreground="{StaticResource TextSecondary}" FontSize="14"
                                       VerticalAlignment="Center" Margin="7,0,0,0" />
                        </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" BorderBrush="#E6DFF3" BorderThickness="0,1,0,0"
                        Padding="42,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BackButton_OnClick"
                                Style="{StaticResource OutlineBackButton}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="←" FontSize="19" Margin="0,0,9,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Назад" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="ContinueButton" Click="ContinueButton_OnClick"
                                IsEnabled="{Binding IsNameValid}"
                                Style="{StaticResource ContinueButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Продолжить" />
                                <TextBlock Text="→" FontSize="20" Margin="16,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Шаг 1 из 3" Foreground="#F6F0FF"
                       HorizontalAlignment="Center" FontSize="15" Margin="0,12,0,0" />
        </Grid>
    </Grid>
</UserControl>
