<UserControl x:Class="ChatPulse.Desktop.Views.Onboarding.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI"
             Foreground="White">
    <UserControl.Resources>
        <!-- Палитра ChatPulse. Размеры и компоновка взяты из Mnemora. -->
        <LinearGradientBrush x:Key="WelcomeBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.48" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WelcomeAccentBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WelcomeLogoBrush" StartPoint="0.1,0.8" EndPoint="0.9,0.1">
            <GradientStop Offset="0" Color="#5A21DB" />
            <GradientStop Offset="0.5" Color="#AA2BED" />
            <GradientStop Offset="1" Color="#F425A9" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WelcomeHeartBrush" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Offset="0" Color="#FFD4FA" />
            <GradientStop Offset="0.56" Color="#F479E6" />
            <GradientStop Offset="1" Color="#F22BA9" />
        </LinearGradientBrush>

        <!-- Mnemora: карточки 166, внутренние отступы 24/22, скругление 18. -->
        <Style x:Key="WelcomeCardStyle" TargetType="Border">
            <Setter Property="Height" Value="166" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <!-- Mnemora: кнопка 70 px, шрифт 21, скругление 13. -->
        <Style x:Key="WelcomeActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="70" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{StaticResource WelcomeAccentBrush}"
                                CornerRadius="13">
                            <Border.Effect>
                                <DropShadowEffect Color="#BA35E8" BlurRadius="22"
                                                  ShadowDepth="0" Opacity="0.28" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource WelcomeBackgroundBrush}" ClipToBounds="True">
        <!-- Декорации используют тот же холст 1600x900, что в Mnemora. -->
        <Viewbox Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1600" Height="900">
                <Ellipse Width="690" Height="690" Canvas.Left="1120" Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#48AE61F3" />
                            <GradientStop Offset="1" Color="#00AE61F3" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620" Canvas.Left="-280" Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#366C46E7" />
                            <GradientStop Offset="1" Color="#006C46E7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280 M92,254 L48,350 L142,402 M236,312 L290,390 L374,420"
                      Stroke="#A569F1" StrokeThickness="1.2" Opacity="0.2" />
                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178 M1342,164 L1310,252 L1390,302 M1495,214 L1450,322 L1554,380 L1600,350"
                      Stroke="#C46CFF" StrokeThickness="1.2" Opacity="0.22" />
                <Ellipse Width="8" Height="8" Canvas.Left="88" Canvas.Top="250" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="232" Canvas.Top="308" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1338" Canvas.Top="160" Fill="#C46CFF" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1491" Canvas.Top="210" Fill="#C46CFF" Opacity="0.5" />
            </Canvas>
        </Viewbox>

        <!-- Основной блок: Mnemora MaxWidth=980, Margin=42,28. Никакого масштабирования Viewbox. -->
        <Grid MaxWidth="980"
              Margin="42,28"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Фирменный логотип ChatPulse в габаритах логотипа Mnemora: 500x138. -->
            <Grid Grid.Row="0" Width="500" Height="138" HorizontalAlignment="Center">
                <Viewbox Width="138" Height="138" HorizontalAlignment="Left" Stretch="Uniform">
                    <Canvas Width="170" Height="170">
                        <Path Fill="{StaticResource WelcomeLogoBrush}"
                              Data="M80,13 C39,13 14,38 14,78 C14,102 25,122 44,134 L38,158 L65,140 C74,143 88,146 101,146 C142,146 166,114 166,78 C166,40 139,13 100,13 Z">
                            <Path.Effect>
                                <DropShadowEffect Color="#B12EFF" BlurRadius="15" ShadowDepth="2" Opacity="0.45" />
                            </Path.Effect>
                        </Path>
                        <Path Fill="{StaticResource WelcomeHeartBrush}"
                              Data="M89,60 C73,39 43,49 43,73 C43,98 75,117 89,130 C106,118 135,97 135,73 C135,49 104,40 89,60 Z" />
                        <Path Data="M38,88 L59,88 L68,79 L77,99 L87,67 L98,107 L107,84 L117,88 L139,88"
                              Stroke="White" StrokeThickness="6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Canvas>
                </Viewbox>
                <StackPanel Margin="149,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="60" FontWeight="SemiBold" TextWrapping="NoWrap">
                        <Run Text="Chat" Foreground="White" />
                        <Run Text="Pulse" Foreground="#F251D2" />
                    </TextBlock>
                    <TextBlock Text="Пульс ваших чатов" FontSize="22"
                               Foreground="#E4DEFF" Margin="2,-2,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="Ваш помощник для активности в чатах"
                       Margin="0,28,0,0"
                       Foreground="White"
                       FontSize="38"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="2"
                       MaxWidth="820"
                       Margin="28,12,28,0"
                       HorizontalAlignment="Center"
                       Foreground="#BEC6DF"
                       FontSize="18"
                       LineHeight="27"
                       Text="Загружайте задания, проходите их по порядку и отмечайте выполнение в одном приложении"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="3" Margin="0,34,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource WelcomeCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform">
                            <Canvas Width="72" Height="60">
                                <Path Data="M10,48 C10,34 20,27 30,27 C40,27 50,34 50,48 M20,15 A10,10 0 1 0 40,15 A10,10 0 1 0 20,15"
                                      Stroke="#B27CFD" StrokeThickness="4" StrokeStartLineCap="Round" Fill="Transparent" />
                                <Path Data="M48,28 C57,28 64,34 64,46 M46,9 A8,8 0 1 0 62,9 A8,8 0 1 0 46,9"
                                      Stroke="#F047B7" StrokeThickness="4" StrokeStartLineCap="Round" Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Один аккаунт — много чатов" Margin="0,11,0,0"
                                   Foreground="White" FontSize="17" FontWeight="Medium"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource WelcomeCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform">
                            <Canvas Width="72" Height="60">
                                <Rectangle Width="15" Height="24" Fill="#866DFF" RadiusX="4" RadiusY="4"
                                           Canvas.Left="8" Canvas.Top="32" />
                                <Rectangle Width="15" Height="38" Fill="#B158F1" RadiusX="4" RadiusY="4"
                                           Canvas.Left="30" Canvas.Top="18" />
                                <Rectangle Width="15" Height="54" Fill="#ED42C8" RadiusX="4" RadiusY="4"
                                           Canvas.Left="52" Canvas.Top="2" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Прогресс и история на устройстве" Margin="0,11,0,0"
                                   Foreground="White" FontSize="17" FontWeight="Medium"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource WelcomeCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Stretch="Uniform">
                            <Canvas Width="65" Height="65">
                                <Path Data="M17,9 L53,9 Q57,9 57,13 L57,56 Q57,60 53,60 L17,60 Q13,60 13,56 L13,13 Q13,9 17,9 Z"
                                      Stroke="#BA69F8" StrokeThickness="4" Fill="Transparent" />
                                <Path Data="M22,25 L27,30 L35,20 M39,26 L50,26 M22,43 L27,48 L35,38 M39,44 L50,44"
                                      Stroke="#F34CBF" StrokeThickness="4" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Пошаговое выполнение заданий" Margin="0,11,0,0"
                                   Foreground="White" FontSize="17" FontWeight="Medium"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button Grid.Row="4"
                    Width="540"
                    Margin="0,38,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource WelcomeActionButtonStyle}"
                    Click="StartButton_OnClick">
                <Grid Width="460">
                    <TextBlock Text="Начать настройку"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <TextBlock Text="➜" FontSize="25"
                               Margin="0,0,20,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
