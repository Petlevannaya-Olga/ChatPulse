<UserControl x:Class="ChatPulse.Desktop.Views.Onboarding.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI"
             FontSize="20"
             FontWeight="SemiBold"
             Foreground="White">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="WelcomeBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#061B37" />
            <GradientStop Offset="0.48" Color="#0C2654" />
            <GradientStop Offset="1" Color="#2B0B6C" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WelcomeAccentBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WelcomeLogoBrush" StartPoint="0.1,0.8" EndPoint="0.9,0.1">
            <GradientStop Offset="0" Color="#5A21DB" />
            <GradientStop Offset="0.5" Color="#AA2BED" />
            <GradientStop Offset="1" Color="#F425A9" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WelcomeHeartBrush" StartPoint="0,0" EndPoint="0.8,1">
            <GradientStop Offset="0" Color="#FFD4FA" />
            <GradientStop Offset="0.56" Color="#F479E6" />
            <GradientStop Offset="1" Color="#F22BA9" />
        </LinearGradientBrush>

        <Style x:Key="WelcomeCardStyle" TargetType="Border">
            <Setter Property="Height" Value="182" />
            <Setter Property="Background" Value="#162F5C" />
            <Setter Property="BorderBrush" Value="#35538A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="WelcomeActionButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="29" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{StaticResource WelcomeAccentBrush}"
                                CornerRadius="18"
                                Padding="20">
                            <Border.Effect>
                                <DropShadowEffect Color="#D22BBE" ShadowDepth="0"
                                                  BlurRadius="25" Opacity="0.32" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.91" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="White" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource WelcomeBackgroundBrush}" ClipToBounds="True">
        <!-- Световые пятна и тонкие линии на фоне (как в Mnemora). -->
        <Viewbox Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1440" Height="840">
                <Ellipse Width="630" Height="630" Canvas.Left="1010" Canvas.Top="-150">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#664D20D2" />
                            <GradientStop Offset="1" Color="#004D20D2" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="570" Height="570" Canvas.Left="-250" Canvas.Top="580">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#3D00C8D8" />
                            <GradientStop Offset="1" Color="#0000C8D8" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,192 L90,240 L155,212 L225,303 L300,267 M90,240 L48,335 L139,382"
                      Stroke="#0CD5E5" StrokeThickness="1.3" Opacity="0.3" />
                <Path Data="M1070,130 L1165,177 L1239,148 L1313,230 L1440,177 M1165,177 L1131,264 L1226,313"
                      Stroke="#BA64FA" StrokeThickness="1.2" Opacity="0.38" />
                <Ellipse Canvas.Left="85" Canvas.Top="235" Width="8" Height="8" Fill="#1BE9E8" />
                <Ellipse Canvas.Left="221" Canvas.Top="299" Width="8" Height="8" Fill="#1BE9E8" />
                <Ellipse Canvas.Left="1161" Canvas.Top="173" Width="8" Height="8" Fill="#D06FF9" />
                <Ellipse Canvas.Left="1309" Canvas.Top="226" Width="8" Height="8" Fill="#D06FF9" />
            </Canvas>
        </Viewbox>

        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="28">
            <Grid Width="1290" Height="790">
                <Grid.RowDefinitions>
                    <RowDefinition Height="263" />
                    <RowDefinition Height="152" />
                    <RowDefinition Height="217" />
                    <RowDefinition Height="158" />
                </Grid.RowDefinitions>

                <!-- Фирменный знак: облачко, сердце, кардиограмма. -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="170" Height="170" Stretch="Uniform">
                        <Canvas Width="170" Height="170">
                            <Path Fill="{StaticResource WelcomeLogoBrush}"
                                  Data="M80,13 C39,13 14,38 14,78 C14,102 25,122 44,134 L38,158 L65,140 C74,143 88,146 101,146 C142,146 166,114 166,78 C166,40 139,13 100,13 Z">
                                <Path.Effect>
                                    <DropShadowEffect Color="#B12EFF" BlurRadius="15" ShadowDepth="2" Opacity="0.45" />
                                </Path.Effect>
                            </Path>
                            <Path Fill="{StaticResource WelcomeHeartBrush}"
                                  Data="M89,60 C73,39 43,49 43,73 C43,98 75,117 89,130 C106,118 135,97 135,73 C135,49 104,40 89,60 Z" />
                            <Path Data="M38,88 L59,88 L68,79 L77,99 L87,67 L98,107 L107,84 L117,88 L139,88"
                                  Stroke="White" StrokeThickness="6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" Margin="22,0,0,0">
                        <TextBlock FontSize="76" FontWeight="SemiBold" Foreground="White">
                            <Run Text="Chat"/><Run Text="Pulse" Foreground="#F251D2"/>
                        </TextBlock>
                        <TextBlock Text="Пульс ваших чатов" FontSize="28"
                                   Foreground="#B8B5EC" Margin="3,-5,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="Ваш помощник для активности в чатах"
                               Foreground="White" FontSize="43" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Загружайте задания, проходите их по порядку и отмечайте выполнение в одном приложении"
                               Foreground="#C9CBE8" FontSize="19" Margin="0,18,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="2" HorizontalAlignment="Center" Width="1160" Margin="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource WelcomeCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="70" Height="60">
                                <Canvas Width="72" Height="60">
                                    <Path Data="M10,48 C10,34 20,27 30,27 C40,27 50,34 50,48 M20,15 A10,10 0 1 0 40,15 A10,10 0 1 0 20,15"
                                          Stroke="#B27CFD" StrokeThickness="4" StrokeStartLineCap="Round" Fill="Transparent" />
                                    <Path Data="M48,28 C57,28 64,34 64,46 M46,9 A8,8 0 1 0 62,9 A8,8 0 1 0 46,9"
                                          Stroke="#F047B7" StrokeThickness="4" StrokeStartLineCap="Round" Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Один аккаунт —" Margin="0,15,0,0" />
                            <TextBlock Text="много чатов" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource WelcomeCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="75" Height="65" Margin="0,0,0,10">
                                <Rectangle Width="15" Height="24" Fill="#866DFF" RadiusX="4" RadiusY="4"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,0" />
                                <Rectangle Width="15" Height="38" Fill="#B158F1" RadiusX="4" RadiusY="4"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,0" />
                                <Rectangle Width="15" Height="54" Fill="#ED42C8" RadiusX="4" RadiusY="4"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,0" />
                            </Grid>
                            <TextBlock Text="Прогресс и история" />
                            <TextBlock Text="на устройстве" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource WelcomeCardStyle}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="68" Height="66" Stretch="Uniform">
                                <Canvas Width="65" Height="65">
                                    <Path Data="M17,9 L53,9 Q57,9 57,13 L57,56 Q57,60 53,60 L17,60 Q13,60 13,56 L13,13 Q13,9 17,9 Z"
                                          Stroke="#BA69F8" StrokeThickness="4" Fill="Transparent" />
                                    <Path Data="M22,25 L27,30 L35,20 M39,26 L50,26 M22,43 L27,48 L35,38 M39,44 L50,44"
                                          Stroke="#F34CBF" StrokeThickness="4" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Пошаговое" Margin="0,7,0,0" />
                            <TextBlock Text="выполнение заданий" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Grid.Row="3" Width="700" Height="92"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource WelcomeActionButtonStyle}"
                        Click="StartButton_OnClick">
                    <Grid>
                        <TextBlock Text="Начать настройку" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="➜" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="39" Margin="0,0,20,0" />
                    </Grid>
                </Button>
            </Grid>
        </Viewbox>
    </Grid>

</UserControl>
