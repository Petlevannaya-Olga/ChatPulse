<UserControl x:Class="ChatPulse.Desktop.Views.Onboarding.OnboardingStepTwoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Палитра приветственного экрана ChatPulse. -->
        <LinearGradientBrush x:Key="OnboardingBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.48" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#24154C" />
        <SolidColorBrush x:Key="TextSecondary" Color="#796C98" />

        <!-- Поле ввода: высота и типографика по образцу ProfileSetupView Mnemora. -->
        <Style x:Key="ProfileTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0,46,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8CCED" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CaretBrush" Value="#874DE9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#874DE9" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- У телефонного поля общая рамка для +7 и редактируемых цифр.
             Рамку рисует внешний Border. Внутри текстового поля нет второго
             Padding/Margin: курсор стоит сразу после префикса. -->
        <Style x:Key="PhoneDigitsTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="CaretBrush" Value="#874DE9" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                      VerticalAlignment="Center" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маленький переключатель видимости без собственной рамки. -->
        <Style x:Key="SecretVisibilityButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1E8FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBackButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F4EFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContinueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9"
                                Background="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#B9B0CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SessionResetIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#FFF1F4" />
            <Setter Property="BorderBrush" Value="#F3C7D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <Grid>
                                <!-- Две одинаковые линии вращаются вокруг общего центра. -->
                                <Border Width="14" Height="2" Background="#C94B68" CornerRadius="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="45" />
                                    </Border.RenderTransform>
                                </Border>
                                <Border Width="14" Height="2" Background="#C94B68" CornerRadius="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="-45" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFE6EC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFD9E2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfilePasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="12,0,18,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8CCED" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CaretBrush" Value="#874DE9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#874DE9" />
                                <Setter TargetName="PasswordBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OnboardingBackgroundBrush}" ClipToBounds="True">
        <!-- Компактная разметка: при минимальном размере окна 1000×650
             карточка и кнопки полностью помещаются без прокрутки. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Декорации используют тот же холст 1600x900, что в Mnemora. -->
        <Viewbox Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1600" Height="900">
                <Ellipse Width="690" Height="690" Canvas.Left="1120" Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#48AE61F3" />
                            <GradientStop Offset="1" Color="#00AE61F3" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620" Canvas.Left="-280" Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#366C46E7" />
                            <GradientStop Offset="1" Color="#006C46E7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280 M92,254 L48,350 L142,402 M236,312 L290,390 L374,420"
                      Stroke="#A569F1" StrokeThickness="1.2" Opacity="0.2" />
                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178 M1342,164 L1310,252 L1390,302 M1495,214 L1450,322 L1554,380 L1600,350"
                      Stroke="#C46CFF" StrokeThickness="1.2" Opacity="0.22" />
                <Ellipse Width="8" Height="8" Canvas.Left="88" Canvas.Top="250" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="232" Canvas.Top="308" Fill="#A569F1" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1338" Canvas.Top="160" Fill="#C46CFF" Opacity="0.5" />
                <Ellipse Width="8" Height="8" Canvas.Left="1491" Canvas.Top="210" Fill="#C46CFF" Opacity="0.5" />
            </Canvas>
        </Viewbox>

        <!-- Чёткий PNG-логотип для интерфейса; .ico остаётся иконкой окна/EXE. -->
        <Grid Grid.Row="0" Width="350" Height="74" Margin="28,6,28,0"
              HorizontalAlignment="Left">
            <Image Source="pack://application:,,,/Resources/ChatPulseLogo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Width="64" Height="64" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Stretch="Uniform" />
            <StackPanel Margin="76,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold">
                    <Run Text="Chat" Foreground="White" /><Run Text="Pulse" Foreground="#F251D2" />
                </TextBlock>
                <TextBlock Text="Пульс ваших чатов" Foreground="#E4DEFF" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Верхний указатель из трёх шагов по образцу Mnemora. -->
        <Grid Grid.Row="1" MaxWidth="610" Height="64"
              HorizontalAlignment="Stretch" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="#7647C4" HorizontalAlignment="Center">
                <TextBlock Text="✓" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Height="3" CornerRadius="2"
                    Background="#A66CE9" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="2" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="3" Height="3" CornerRadius="2"
                    Background="#75539C" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="4" Width="40" Height="40" CornerRadius="20"
                    BorderBrush="#75539C" BorderThickness="2" HorizontalAlignment="Center">
                <TextBlock Text="3" Foreground="#C9B9E5" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="О себе" Foreground="#E9DCFF"
                       FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Telegram" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Первый чат" Foreground="#C9B9E5"
                       FontSize="14" TextAlignment="Center" />
        </Grid>

        <!-- Та же карточка/подвал/кнопки, что на шаге «О себе». -->
        <!-- Card grows to fit the current Telegram substep and validation messages.
             Viewbox only scales it down if the window is too small. -->
        <Viewbox Grid.Row="2" Margin="40,0" Stretch="Uniform" StretchDirection="DownOnly"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="720">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MaxWidth="720" Margin="0,8,0,0"
                    Background="White" CornerRadius="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#10052B" BlurRadius="28" ShadowDepth="8" Opacity="0.3" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="48,20,48,0">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse Fill="#F5EEFF" Stroke="#A74BF0" StrokeThickness="2.5" />
                            <!-- Telegram symbol in the same avatar circle as on step 1. -->
                            <Path Data="M 9,25 L 41,10 L 33,40 L 24,31 L 18,36 L 20,26 Z"
                                  Fill="#8241D8" Stretch="Uniform" Margin="18" />
                        </Grid>
                        <TextBlock Text="Подключение Telegram" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextAlignment="Center"
                                   Margin="0,9,0,0" />
                        <TextBlock Text="Один аккаунт для всех ваших чатов" FontSize="17"
                                   Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                   Margin="0,2,0,0" />

                        <!-- Compact recovery notice: one row, with retry action on the right. -->
                        <Border x:Name="SessionRetryCard" Margin="0,10,0,8" Background="#FFF7FB"
                                BorderBrush="#F0C7D8" BorderThickness="1" CornerRadius="16"
                                Padding="16,12"
                                Visibility="{Binding IsSessionRetryNeeded, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                        Background="#FFE9F1" BorderBrush="#F2C1D4" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#C34771"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="Не удалось проверить Telegram-сессию"
                                           FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                <Button Grid.Column="4" IsEnabled="{Binding CanRetrySession}"
                                        Click="RetryRestoreButton_OnClick"
                                        Padding="12,8" FontSize="14" FontWeight="SemiBold"
                                        Background="White" BorderBrush="#DEC8EF" BorderThickness="1"
                                        Foreground="#7134B5" Cursor="Hand"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        FocusVisualStyle="{x:Null}"
                                        ToolTip="Повторить проверку сохранённой Telegram-сессии"
                                        AutomationProperties.Name="Повторить проверку Telegram-сессии">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RetrySurface" CornerRadius="9"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RetrySurface" Property="Background" Value="#F4EFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RetrySurface" Property="Background" Value="#EDE1FC" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="RetrySurface" Property="Opacity" Value="0.55" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- Vector icon and label share a fixed-height grid,
                                         avoiding the font baseline shift of the ↻ character. -->
                                    <Grid Height="20" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="16" Height="16"
                                              VerticalAlignment="Center" Stretch="Uniform"
                                              Stroke="#7134B5" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 21,2 L 21,8 15,8 M 3,22 L 3,16 9,16 M 3.09,9 A 9,9 0 0 1 17.97,5.64 L 21,8 M 3,16 L 6.03,18.36 A 9,9 0 0 0 20.91,15" />
                                        <TextBlock Grid.Column="2" Text="Повторить"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="#7134B5" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <Border x:Name="SessionResetCard" Margin="0,10,0,8" Background="#FFF7FB"
                                BorderBrush="#F0C7D8" BorderThickness="1" CornerRadius="16"
                                Padding="16,14"
                                Visibility="{Binding IsSessionRecoveryNeeded, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="#FFE9F1" BorderBrush="#F2C1D4" BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="!" FontSize="18" FontWeight="Bold" Foreground="#C34771"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Требуется повторная авторизация"
                                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="{Binding Error}" Margin="0,4,0,0"
                                                   FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Очистить сессию и войти заново"
                                        IsEnabled="{Binding CanResetTelegramSession}"
                                        Click="ResetTelegramSessionButton_OnClick"
                                        Style="{StaticResource OutlineBackButton}"
                                        Foreground="#B54865" HorizontalAlignment="Center"
                                        Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Личные API-параметры: отдельный этап внутри шага 2.
                             В settings.json не храним секреты. -->
                        <StackPanel x:Name="ApiKeysPanel" Margin="0,9,0,0" Visibility="Visible">
                            <!-- Help is a link next to API configuration, not a second button below the form. -->
                            <Button x:Name="ApiKeysHelpButton" Click="ApiKeysHelpButton_OnClick" Background="Transparent"
                                    BorderThickness="0" Margin="0,0,0,8"
                                    HorizontalAlignment="Center" Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    ToolTip="Пошаговая инструкция по получению API ID и API Hash">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!-- Simple open-book outline, consistent with the violet ChatPulse accents. -->
                                            <Path Data="M 12,6 C 9,4 6,4 2,4 L 2,18 C 6,18 9,18 12,20 M 12,6 C 15,4 18,4 22,4 L 22,18 C 18,18 15,18 12,20 M 12,6 L 12,20"
                                                  Width="19" Height="19" Stretch="Uniform"
                                                  Stroke="#7A32C8" StrokeThickness="1.8"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="HelpLinkText"
                                                       Text="Как получить API ID и API Hash?"
                                                       Foreground="#7A32C8" FontSize="14"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HelpLinkText" Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel x:Name="ApiSavedPanel" Visibility="Collapsed">
                                <!-- In recovery states the actions are hidden, so reserve breathing room
                                     below the saved-keys message before the footer separator. -->
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0,14,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionRetryNeeded}" Value="True">
                                                <Setter Property="Margin" Value="0,6,0,22" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSessionRecoveryNeeded}" Value="True">
                                                <Setter Property="Margin" Value="0,6,0,22" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Grid Width="19" Height="19" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse Fill="#E9F8F1" Stroke="#28A873" StrokeThickness="1" />
                                        <TextBlock Text="✓" Foreground="#198759" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="API-ключи сохранены на этом компьютере — повторный ввод не нужен."
                                               FontSize="13" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" TextWrapping="NoWrap" />
                                </StackPanel>
                                <!-- Переход к номеру выполняется общей кнопкой «Продолжить»
                                     в нижней панели шага. Здесь остаются действия с ключами. -->
                                <StackPanel x:Name="ApiSavedActionsPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                            Margin="0,14,0,14">
                                    <Button Content="Изменить API-ключи"
                                            Margin="0,0,18,0"
                                            IsEnabled="{Binding CanEditApiCredentials}"
                                            Click="ApiKeysEditButton_OnClick"
                                            Style="{StaticResource OutlineBackButton}" />
                                    <Button Content="Удалить API-ключи"
                                            IsEnabled="{Binding CanDeleteApiCredentials}"
                                            Click="ApiKeysDeleteButton_OnClick"
                                            Style="{StaticResource OutlineBackButton}"
                                            Foreground="#B54865" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="ApiCredentialsEntryPanel">
                                <TextBlock Text="API ID" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                <!-- Ограничения показываются серым внутри пустого поля, а не в ToolTip. -->
                                <Grid Height="52">
                                    <TextBox x:Name="ApiIdInput" Style="{StaticResource ProfileTextBox}"
                                             Padding="12,0,12,0" MaxLength="10"
                                             InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="ApiIdInput_OnPreviewTextInput"
                                             TextChanged="ApiIdInput_OnTextChanged"
                                             LostKeyboardFocus="ApiIdInput_OnLostKeyboardFocus" />
                                    <TextBlock x:Name="ApiIdHint"
                                               Text="только цифры: от 1 до 2 147 483 647"
                                               FontSize="14" Foreground="#9A90AD"
                                               Margin="14,0,12,0" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock x:Name="ApiIdErrorText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="#C83A60" Margin="2,4,0,0" Visibility="Collapsed" />
                                <TextBlock Text="API Hash" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,9,0,4" />
                                <Grid Height="52">
                                    <PasswordBox x:Name="ApiHashInput" Style="{StaticResource ProfilePasswordBox}"
                                                 Padding="12,0,48,0" MaxLength="32"
                                                 PasswordChanged="ApiHashInput_OnPasswordChanged"
                                                 LostKeyboardFocus="ApiHashInput_OnLostKeyboardFocus" />
                                    <TextBox x:Name="ApiHashVisibleInput" Style="{StaticResource ProfileTextBox}"
                                             Padding="12,0,48,0" MaxLength="32"
                                             Visibility="Collapsed" TextChanged="ApiHashVisibleInput_OnTextChanged"
                                             LostKeyboardFocus="ApiHashInput_OnLostKeyboardFocus" />
                                    <TextBlock x:Name="ApiHashHint" Text="32 символа: 0–9, a–f"
                                               FontSize="14" Foreground="#9A90AD"
                                               Margin="14,0,48,0" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <Button x:Name="ApiHashVisibilityButton" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,5,0"
                                            Style="{StaticResource SecretVisibilityButton}"
                                            Click="ApiHashVisibilityButton_OnClick"
                                            ToolTip="Показать API Hash"
                                            AutomationProperties.Name="Показать API Hash">
                                        <Grid Width="22" Height="22">
                                            <Path Data="M 2,11 C 6,4 16,4 20,11 C 16,18 6,18 2,11 Z"
                                                  Stroke="#72568B" StrokeThickness="1.6" Fill="Transparent" />
                                            <Ellipse Width="6" Height="6" Stroke="#72568B" StrokeThickness="1.6"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Path x:Name="ApiHashEyeSlash" Data="M 3,19 L 19,3"
                                                  Stroke="#72568B" StrokeThickness="2" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="ApiHashErrorText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="#C83A60" Margin="2,4,0,0" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Path Width="15" Height="15" VerticalAlignment="Center"
                                          Data="M 4,6 L 4,4 A 3,3 0 0 1 10,4 L 10,6 M 3,6 L 11,6 L 11,13 L 3,13 Z"
                                          Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Fill="Transparent" Stretch="Uniform" />
                                    <TextBlock Text="Ключи сохраняются только на этом компьютере."
                                               Foreground="{StaticResource TextSecondary}" FontSize="13"
                                               VerticalAlignment="Center" Margin="7,0,0,0" />
                                </StackPanel>
                                <Grid x:Name="ApiActionButtonsGrid" Margin="0,9,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="ApiCancelColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ApiSaveButton" Grid.Column="0" Grid.ColumnSpan="2" Content="Сохранить ключи"
                                            Click="ApiKeysSaveButton_OnClick"
                                            Style="{StaticResource ContinueButtonStyle}"
                                            IsEnabled="{Binding CanSaveApiCredentials}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" x:Name="ApiCancelButton"
                                            Content="Отменить изменение"
                                            Click="ApiKeysCancelButton_OnClick"
                                            Style="{StaticResource OutlineBackButton}"
                                            Height="48"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                                <Button Content="Удалить повреждённые API-ключи и сессию"
                                        Visibility="{Binding IsApiCredentialsCorrupted, Converter={StaticResource BoolToVisibility}}"
                                        IsEnabled="{Binding CanDeleteApiCredentials}"
                                        Click="ApiKeysDeleteButton_OnClick"
                                        Style="{StaticResource OutlineBackButton}"
                                        Foreground="#B54865" HorizontalAlignment="Center"
                                        Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Ошибка занимает место только когда есть текст.
                             Высота карточки увеличивается, а нижняя панель
                             всегда идёт после содержимого. -->
                        <Border Margin="0,12,0,4" Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasError}" Value="True" />
                                                <Condition Binding="{Binding IsSessionRetryNeeded}" Value="False" />
                                                <Condition Binding="{Binding IsSessionRecoveryNeeded}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ScrollViewer MaxHeight="92"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <TextBlock Text="{Binding Error}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="#D0446A" />
                            </ScrollViewer>
                        </Border>

                        <!-- Each state replaces the previous one; no duplicate phone/code inputs. -->
                        <StackPanel x:Name="PhonePanel" Margin="0,14,0,0">
                            <TextBlock x:Name="PhoneSectionTitle" Text="Номер телефона Telegram" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                            <!-- Как в первом шаге: единое поле с фиолетовой рамкой
                                 при фокусе. Префикс и ввод — соседние колонки,
                                 поэтому каретка не зависит от больших отступов. -->
                            <Border Height="52" Background="White" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#D8CCED" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=PhoneInput, Path=IsKeyboardFocused}"
                                                         Value="True">
                                                <Setter Property="BorderBrush" Value="#874DE9" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Margin="12,0,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="+7" FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <Grid Grid.Column="2">
                                        <TextBox x:Name="PhoneInput"
                                                 Style="{StaticResource PhoneDigitsTextBox}"
                                                 InputMethod.IsInputMethodEnabled="False"
                                                 PreviewTextInput="PhoneInput_OnPreviewTextInput"
                                                 PreviewKeyDown="PhoneInput_OnPreviewKeyDown"
                                                 TextChanged="PhoneInput_OnTextChanged"
                                                 GotFocus="PhoneInput_OnFocusChanged"
                                                 LostFocus="PhoneInput_OnFocusChanged"
                                                 ToolTip="Введите 10 цифр номера после +7" />
                                        <TextBlock x:Name="PhonePlaceholder"
                                                   Text="(___) ___-__-__" FontSize="18"
                                                   Foreground="#ADA0C7" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="✓" FontSize="22"
                                               FontWeight="Bold" Foreground="#20A96A"
                                               Margin="12,0,0,0" IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsPhoneComplete, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Код +7 указан автоматически. Введите оставшиеся 10 цифр."
                                       Foreground="{StaticResource TextSecondary}" FontSize="14"
                                       Margin="0,5,0,0" />
                            <Button Click="StartButton_OnClick" IsEnabled="{Binding CanStart}"
                                    Style="{StaticResource ContinueButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    Content="Получить код" />
                        </StackPanel>

                        <StackPanel x:Name="ConfirmPanel" Margin="0,10,0,0"
                                    Visibility="{Binding IsAwaitingInput, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Prompt}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                            <TextBox x:Name="ConfirmationInput" Style="{StaticResource ProfileTextBox}"
                                     Padding="12,0,12,0"
                                     TextChanged="ConfirmationInput_OnTextChanged"
                                     LostKeyboardFocus="ConfirmationInput_OnLostKeyboardFocus" />
                            <TextBlock x:Name="ConfirmationErrorText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="#C83A60" Margin="2,4,0,0" Visibility="Collapsed" />
                            <Grid x:Name="CloudPasswordContainer" Height="52" Visibility="Collapsed">
                                <PasswordBox x:Name="PasswordInput" Style="{StaticResource ProfilePasswordBox}"
                                             Padding="12,0,48,0" PasswordChanged="CloudPasswordInput_OnChanged"
                                             LostKeyboardFocus="CloudPasswordInput_OnLostKeyboardFocus" />
                                <TextBox x:Name="CloudPasswordVisibleInput" Style="{StaticResource ProfileTextBox}"
                                         Padding="12,0,48,0" Visibility="Collapsed"
                                         TextChanged="CloudPasswordVisibleInput_OnTextChanged"
                                         LostKeyboardFocus="CloudPasswordInput_OnLostKeyboardFocus" />
                                <Button x:Name="CloudPasswordVisibilityButton" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,5,0"
                                        Style="{StaticResource SecretVisibilityButton}"
                                        Click="CloudPasswordVisibilityButton_OnClick"
                                        ToolTip="Показать пароль"
                                        AutomationProperties.Name="Показать пароль">
                                    <Grid Width="22" Height="22">
                                        <Path Data="M 2,11 C 6,4 16,4 20,11 C 16,18 6,18 2,11 Z"
                                              Stroke="#72568B" StrokeThickness="1.6" Fill="Transparent" />
                                        <Ellipse Width="6" Height="6" Stroke="#72568B" StrokeThickness="1.6"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path x:Name="CloudPasswordEyeSlash" Data="M 3,19 L 19,3"
                                              Stroke="#72568B" StrokeThickness="2" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="CloudPasswordErrorText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="#C83A60" Margin="2,4,0,0" Visibility="Collapsed" />
                            <TextBlock Text="{Binding PromptHint}" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" />
                            <Button Content="Подтвердить" Click="ConfirmButton_OnClick"
                                    Style="{StaticResource ContinueButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    IsEnabled="{Binding CanConfirm}" />
                            <Button Content="Отменить вход и изменить номер"
                                    Click="CancelLoginButton_OnClick"
                                    IsEnabled="{Binding CanCancelLogin}"
                                    Style="{StaticResource OutlineBackButton}"
                                    HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <Button x:Name="ResendCodeButton" Click="ResendCodeButton_OnClick"
                                    Content="{Binding ResendButtonText}"
                                    IsEnabled="{Binding CanResendCode}"
                                    Visibility="{Binding HasResendOption, Converter={StaticResource BoolToVisibility}}"
                                    Style="{StaticResource OutlineBackButton}"
                                    Foreground="#7732BE"
                                    HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding ResendStatus}"
                                       Visibility="{Binding HasResendStatus, Converter={StaticResource BoolToVisibility}}"
                                       TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" Margin="0,7,0,0" />
                        </StackPanel>

                        <Border x:Name="ConnectedPanel" Margin="0,22,0,22" Padding="18,16"
                                Background="#F8F4FF" BorderBrush="#E7DAFB" BorderThickness="1"
                                CornerRadius="18"
                                Visibility="{Binding IsAuthorized, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="54" Height="54"
                                        Background="#EEE1FF" BorderBrush="#D1B7FF" BorderThickness="1"
                                        CornerRadius="27" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectedAccountInitials}" FontSize="18" FontWeight="Bold"
                                               Foreground="#7A32C8" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" TextAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ConnectedAccount}" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="Аккаунт подключён" Foreground="#23915F" FontSize="13"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <Button Grid.Column="3"
                                        Style="{StaticResource SessionResetIconButtonStyle}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        ToolTip="Сбросить Telegram-сессию"
                                        IsEnabled="{Binding CanResetTelegramSession}"
                                        Click="ResetTelegramSessionButton_OnClick" />
                            </Grid>
                        </Border>

                        <!-- Старая инструкция остаётся для этапа телефона. -->
                        <Button x:Name="TelegramHelpButton" Click="HelpButton_OnClick" Background="Transparent"
                                BorderThickness="0" Margin="0,6,0,18"
                                HorizontalAlignment="Center" Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Content="Как подключить Telegram?">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="HelpText"
                                               Text="{TemplateBinding Content}"
                                               Foreground="#7A32C8" FontSize="15"
                                               FontWeight="SemiBold" TextAlignment="Center" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HelpText" Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="#E6DFF3" BorderThickness="0,1,0,0"
                            Padding="42,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="BackButton_OnClick"
                                    Style="{StaticResource OutlineBackButton}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="←" FontSize="19" Margin="0,0,9,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Назад" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TelegramContinueButton" Grid.Column="2" Click="ContinueButton_OnClick"
                                    Style="{StaticResource ContinueButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Продолжить" />
                                    <TextBlock Text="→" FontSize="20" Margin="16,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Шаг 2 из 3" Foreground="#F6F0FF"
                       HorizontalAlignment="Center" FontSize="15" Margin="0,12,0,0" />
        </Grid>
        </Viewbox>
    </Grid>
</UserControl>
