<UserControl x:Name="Root" x:Class="ChatPulse.Desktop.Views.Onboarding.OnboardingStepThreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             IsVisibleChanged="OnVisibilityChanged"
             FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <LinearGradientBrush x:Key="OnboardingBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.48" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#24154C" />
        <SolidColorBrush x:Key="TextSecondary" Color="#796C98" />

        <!-- Поиск оформлен тем же полем с фокусной рамкой, что и ввод на шаге Telegram. -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="42,0,44,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8CCED" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CaretBrush" Value="#874DE9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#874DE9" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBackButton" TargetType="Button">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F4EFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContinueButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9"
                                Background="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#B9B0CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Grid Background="{StaticResource OnboardingBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1600" Height="900">
                <Ellipse Width="690" Height="690" Canvas.Left="1120" Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#48AE61F3" />
                            <GradientStop Offset="1" Color="#00AE61F3" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620" Canvas.Left="-280" Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#366C46E7" />
                            <GradientStop Offset="1" Color="#006C46E7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280 M92,254 L48,350 L142,402 M236,312 L290,390 L374,420"
                      Stroke="#A569F1" StrokeThickness="1.2" Opacity="0.2" />
                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178 M1342,164 L1310,252 L1390,302 M1495,214 L1450,322 L1554,380"
                      Stroke="#C46CFF" StrokeThickness="1.2" Opacity="0.22" />
            </Canvas>
        </Viewbox>

        <Grid Grid.Row="0" Width="350" Height="74" Margin="28,6,28,0"
              HorizontalAlignment="Left">
            <Image Source="pack://application:,,,/Resources/ChatPulseLogo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Width="64" Height="64" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Stretch="Uniform" />
            <StackPanel Margin="76,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold">
                    <Run Text="Chat" Foreground="White" /><Run Text="Pulse" Foreground="#F251D2" />
                </TextBlock>
                <TextBlock Text="Пульс ваших чатов" Foreground="#E4DEFF" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Те же индикаторы, что на первых двух шагах. -->
        <Grid Grid.Row="1" MaxWidth="610" Height="64"
              HorizontalAlignment="Stretch" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="#7647C4" HorizontalAlignment="Center">
                <TextBlock Text="✓" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Height="3" CornerRadius="2"
                    Background="#A66CE9" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                    Background="#7647C4" HorizontalAlignment="Center">
                <TextBlock Text="✓" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="3" Height="3" CornerRadius="2"
                    Background="#A66CE9" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="4" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="3" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="О себе" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Telegram" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Чаты" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="42,8,42,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MaxWidth="900" Background="White" CornerRadius="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect Color="#10052B" BlurRadius="28" ShadowDepth="8" Opacity="0.3" />
                </Border.Effect>
                <Grid DataContext="{Binding ElementName=Root}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="36,16,36,20" HorizontalAlignment="Center">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Ellipse Fill="#F5EEFF" Stroke="#A74BF0" StrokeThickness="2.5" />
                            <!-- Иконка чатов вместо логотипа Telegram. -->
                            <Viewbox Width="39" Height="39" HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="48" Height="48">
                                    <Path Data="M 12,8 H 35 A 7,7 0 0 1 42,15 V 27 A 7,7 0 0 1 35,34 H 29 L 24,40 V 34 H 12 A 7,7 0 0 1 5,27 V 15 A 7,7 0 0 1 12,8 Z"
                                          Fill="Transparent" Stroke="#8241D8" StrokeThickness="3.3"
                                          StrokeLineJoin="Round" />
                                    <Path Data="M 14,19 H 33 M 14,25 H 27" Stroke="#8241D8"
                                          StrokeThickness="3.3" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <TextBlock Text="Подключение чатов" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextAlignment="Center" Margin="0,9,0,0" />
                        <TextBlock Text="Выберите Telegram-чаты для проверки. Соцсеть заданий определим по сообщениям."
                                   FontSize="14" Foreground="{StaticResource TextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="36,0,36,16">
                        <Grid Visibility="{Binding SelectionVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,6,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="ChatSearchInput"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchTextBox}" />
                                    <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24"
                                                             Foreground="#796C98"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center" Margin="14,0,0,0"
                                                             IsHitTestVisible="False" />
                                    <TextBlock Text="Поиск по чатам Telegram"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="15" VerticalAlignment="Center"
                                               Margin="44,0,10,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ChatSearchInput, Path=Text}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Очистка появляется, только когда в поиске есть текст. -->
                                    <Button x:Name="ClearSearchButton"
                                            Width="34" Height="34" Margin="0,0,8,0"
                                            Panel.ZIndex="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="White"
                                            Cursor="Hand" FocusVisualStyle="{x:Null}"
                                            ToolTip="Очистить поиск" AutomationProperties.Name="Очистить поиск"
                                            Click="ClearSearch_OnClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBackButton}">
                                                <!-- В базовом стиле Padding=14,10: из-за него иконка сжималась почти до точки. -->
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=ChatSearchInput, Path=Text}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ElementName=ChatSearchInput, Path=Text}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <materialDesign:PackIcon Kind="Close"
                                                                 Width="22" Height="22"
                                                                 Foreground="#7545C8"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                                <!-- Принудительно перечитывает список чатов с Telegram. -->
                                <Button Grid.Column="1" Click="RefreshButton_OnClick"
                                        Width="52" Height="52" Margin="10,0,0,0"
                                        Style="{StaticResource OutlineBackButton}"
                                        ToolTip="Обновить список чатов из Telegram"
                                        AutomationProperties.Name="Обновить список чатов">
                                    <materialDesign:PackIcon Kind="Refresh" Width="29" Height="29"
                                                             Foreground="#7545C8"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <TextBlock Text="{Binding ListStatus}" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                                <TextBlock Text="{Binding SelectedCountText}" HorizontalAlignment="Right"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#7545C8" />
                            </Grid>
                            <Border Grid.Row="2" BorderBrush="#E6DFF3" BorderThickness="1" CornerRadius="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding VisibleRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="12,10,12,0"
                                                        Padding="12,10"
                                                        Background="#FCFAFF"
                                                        BorderBrush="#E7DCF7"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Checked="ChatCheckBox_OnChanged"
                                                              Unchecked="ChatCheckBox_OnChanged"
                                                              VerticalAlignment="Top">
                                                        <TextBlock Margin="6,0,0,0" FontSize="15"
                                                                   Foreground="#24154C" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                            <Run Text="  ·  " Foreground="#B4A6C9" />
                                                            <Run Text="{Binding Kind, Mode=OneWay}" FontSize="12" Foreground="#796C98" />
                                                        </TextBlock>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <Grid Visibility="{Binding ReviewVisibility}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,10,0,12">
                                <TextBlock Text="Результаты проверки" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Выбранные чаты показаны ниже. Анализ сообщений пока не подключён: статус и соцсеть не определены."
                                           TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"
                                           FontSize="13" Margin="0,6,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" BorderBrush="#E6DFF3" BorderThickness="1" CornerRadius="12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="12,10,12,0"
                                                        Padding="12,10"
                                                        Background="#FCFAFF"
                                                        BorderBrush="#E7DCF7"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="15"
                                                                   FontWeight="SemiBold" Foreground="#24154C"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="Не анализировался · Соцсеть не определена"
                                                                   FontSize="12" Margin="0,4,0,0" Foreground="#796C98" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="#E6DFF3" BorderThickness="0,1,0,0" Padding="36,15">
                        <Grid>
                            <Button HorizontalAlignment="Left" Content="←  Назад" Click="BackButton_OnClick"
                                    Style="{StaticResource OutlineBackButton}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="К выбору" Click="ReturnToSelection_OnClick"
                                        Visibility="{Binding ReviewVisibility}"
                                        Style="{StaticResource OutlineBackButton}" Margin="0,0,12,0" />
                                <Button Content="Продолжить  →" Click="ShowReview_OnClick"
                                        Visibility="{Binding SelectionVisibility}"
                                        IsEnabled="{Binding HasSelection}"
                                        Style="{StaticResource ContinueButtonStyle}" />
                                <Button Content="Подключить чаты" IsEnabled="False"
                                        ToolTip="Подключение станет доступно после реализации анализа и подтверждения"
                                        Visibility="{Binding ReviewVisibility}"
                                        Style="{StaticResource ContinueButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Шаг 3 из 3" Foreground="#F6F0FF"
                       HorizontalAlignment="Center" FontSize="15" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</UserControl>
