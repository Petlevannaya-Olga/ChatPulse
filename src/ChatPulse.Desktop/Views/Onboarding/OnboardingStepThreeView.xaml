<UserControl x:Class="ChatPulse.Desktop.Views.Onboarding.OnboardingStepThreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             IsVisibleChanged="OnVisibilityChanged"
             FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <LinearGradientBrush x:Key="OnboardingBackgroundBrush" StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038" />
            <GradientStop Offset="0.48" Color="#26144E" />
            <GradientStop Offset="1" Color="#401365" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#24154C" />
        <SolidColorBrush x:Key="TextSecondary" Color="#796C98" />

        <!-- Контрольные шаблоны и состояния фокуса/disabled/ripple берём из Material Design,
             размеры и текстовую палитру оставляем от существующего ChatPulse. -->
        <Style x:Key="FieldTextBox" TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldComboBox" TargetType="ComboBox"
               BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="48" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="TextButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#7545C8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource OnboardingBackgroundBrush}" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox Grid.RowSpan="3" Stretch="Fill" IsHitTestVisible="False">
            <Canvas Width="1600" Height="900">
                <Ellipse Width="690" Height="690" Canvas.Left="1120" Canvas.Top="-220">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#48AE61F3" />
                            <GradientStop Offset="1" Color="#00AE61F3" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620" Canvas.Left="-280" Canvas.Top="510">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#366C46E7" />
                            <GradientStop Offset="1" Color="#006C46E7" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path Data="M0,210 L92,254 L165,224 L236,312 L314,280 M92,254 L48,350 L142,402 M236,312 L290,390 L374,420"
                      Stroke="#A569F1" StrokeThickness="1.2" Opacity="0.2" />
                <Path Data="M1260,118 L1342,164 L1420,130 L1495,214 L1600,178 M1342,164 L1310,252 L1390,302 M1495,214 L1450,322 L1554,380"
                      Stroke="#C46CFF" StrokeThickness="1.2" Opacity="0.22" />
            </Canvas>
        </Viewbox>

        <Grid Grid.Row="0" Width="350" Height="74" Margin="28,6,28,0"
              HorizontalAlignment="Left">
            <Image Source="pack://application:,,,/Resources/ChatPulseLogo.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Width="64" Height="64" HorizontalAlignment="Left"
                   VerticalAlignment="Center" Stretch="Uniform" />
            <StackPanel Margin="76,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold">
                    <Run Text="Chat" Foreground="White" /><Run Text="Pulse" Foreground="#F251D2" />
                </TextBlock>
                <TextBlock Text="Пульс ваших чатов" Foreground="#E4DEFF" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Те же индикаторы, что на первых двух шагах. -->
        <Grid Grid.Row="1" MaxWidth="610" Height="64"
              HorizontalAlignment="Stretch" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="112" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                    Background="#7647C4" HorizontalAlignment="Center">
                <TextBlock Text="✓" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="1" Height="3" CornerRadius="2"
                    Background="#A66CE9" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                    Background="#7647C4" HorizontalAlignment="Center">
                <TextBlock Text="✓" Foreground="White" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Column="3" Height="3" CornerRadius="2"
                    Background="#A66CE9" VerticalAlignment="Center" Margin="4,0" />
            <Border Grid.Column="4" Width="40" Height="40" CornerRadius="20"
                    Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center">
                <TextBlock Text="3" Foreground="White" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="О себе" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Telegram" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="4" Text="Первый чат" Foreground="White"
                       FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" Margin="42,8,42,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" MaxWidth="820" MaxHeight="570"
                    Background="White" CornerRadius="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect Color="#10052B" BlurRadius="28" ShadowDepth="8" Opacity="0.3" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <StackPanel Margin="42,16,42,18">
                            <Grid Width="58" Height="58" HorizontalAlignment="Center">
                                <Ellipse Fill="#F5EEFF" Stroke="#A74BF0" StrokeThickness="2" />
                                <materialDesign:PackIcon Kind="ForumOutline" Width="33" Height="33"
                                                         Foreground="#874DE9"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Настройте первый чат" Foreground="{StaticResource TextPrimary}"
                                       FontSize="27" FontWeight="Bold" TextAlignment="Center"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="Выберите чат Telegram и задайте параметры активности"
                                       Foreground="{StaticResource TextSecondary}" FontSize="15"
                                       TextAlignment="Center" Margin="0,2,0,14" TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Чат Telegram" Foreground="{StaticResource TextPrimary}"
                                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Обновить список"
                                        Click="RefreshButton_OnClick"
                                        IsEnabled="{Binding CanRefresh}"
                                        Style="{StaticResource TextButton}"
                                        Foreground="#874DE9" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat, Mode=TwoWay}"
                                      Style="{StaticResource FieldComboBox}"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Title">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Kind}" Margin="12,0,0,0"
                                                       Foreground="{StaticResource TextSecondary}" FontSize="13" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="2,6,2,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}"
                                       FontSize="12" Margin="3,5,0,9" TextWrapping="Wrap" />

                            <TextBlock Text="Название в ChatPulse" Foreground="{StaticResource TextPrimary}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="100" Style="{StaticResource FieldTextBox}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Соцсеть заданий" Foreground="{StaticResource TextPrimary}"
                                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding SocialNetworks}"
                                              SelectedItem="{Binding SocialNetwork, Mode=TwoWay}"
                                              Style="{StaticResource FieldComboBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Дата начала активности" Foreground="{StaticResource TextPrimary}"
                                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                Height="48" FontSize="15" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Задания будем загружать начиная с 00:00 выбранной даты."
                                       Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       Margin="3,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Error}" Foreground="#C34365" FontSize="13"
                                       FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="✓  Чат сохранён на этом компьютере"
                                       Foreground="#149768" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,9,0,0" TextAlignment="Center"
                                       Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderBrush="#E6DFF3" BorderThickness="0,1,0,0"
                            Padding="35,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="BackButton_OnClick"
                                    Style="{StaticResource ChatPulseOnboardingOutlinedButton}" Width="248" Content="←  Назад" />
                            <Button Grid.Column="2" Click="SaveButton_OnClick"
                                    IsEnabled="{Binding CanSave}"
                                    Style="{StaticResource ChatPulseOnboardingPrimaryButton}" Width="248" Content="Сохранить первый чат  →" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="1" Text="Шаг 3 из 3" Foreground="#F6F0FF"
                       HorizontalAlignment="Center" FontSize="15" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</UserControl>
