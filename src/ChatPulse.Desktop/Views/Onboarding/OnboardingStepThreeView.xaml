<UserControl x:Class="ChatPulse.Desktop.Views.Onboarding.OnboardingStepThreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Segoe UI">
    <Grid>
        <Grid.Background><LinearGradientBrush StartPoint="0,0.2" EndPoint="1,0.8">
            <GradientStop Offset="0" Color="#171038"/><GradientStop Offset="0.48" Color="#26144E"/><GradientStop Offset="1" Color="#401365"/>
        </LinearGradientBrush></Grid.Background>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            <TextBlock Text="Первый чат — шаг 3 из 3" FontSize="28" Foreground="White" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="На следующем этапе добавим выбор чата и дату начала активности. Пока настройка не завершена." TextWrapping="Wrap" TextAlignment="Center" Foreground="#E4DEFF" Margin="0,16,0,22" FontSize="16"/>
            <Button Content="← Назад к Telegram" Width="210" Height="46" HorizontalAlignment="Center" Click="BackButton_OnClick" Background="#874DE9" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</UserControl>
