<Window x:Class="ChatPulse.Desktop.Views.Dialogs.WorkspaceTaskExecutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:workspace="clr-namespace:ChatPulse.Desktop.Views.Workspace"
        Title="Выполнение заданий — ChatPulse" Width="760" Height="670" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Dialog_OnClosing">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#7545B9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.90" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Width" Value="194" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#F2EAFB" />
            <Setter Property="Foreground" Value="#6940A0" />
            <Setter Property="BorderBrush" Value="#DFCFF2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E9DCF8" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#BD9BEB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E1D0F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border Background="White" CornerRadius="20" Padding="26,22">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="24" ShadowDepth="5" Opacity="0.28" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Выполнение заданий" FontSize="22" FontWeight="SemiBold" Foreground="#24154C" />
                    <TextBlock x:Name="ChatTitle" Foreground="#78678A" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="13" Background="#F7F2FD" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepText" Text="Подготавливаем задания…"
                                       Foreground="#352352" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="CountText" Grid.Column="1" Text="0 / 0"
                                       Foreground="#7545B9" FontWeight="SemiBold" FontSize="13" />
                        </Grid>
                        <ProgressBar x:Name="ExecutionProgress" Minimum="0" Maximum="1" Height="9"
                                     Background="#E8DDF5" Foreground="#7545B9" Margin="0,11,0,9" />
                        <TextBlock x:Name="RemainingText" Foreground="#74628A" FontSize="12" />
                    </StackPanel>
                </Border>
                <!-- The entire card is animated as one surface: its border, background,
                     task text and link buttons turn together. Progress and footer stay fixed. -->
                <Border x:Name="FlippingCard" Grid.Row="2" Background="#FCFAFF" CornerRadius="15"
                        BorderBrush="#E9DFF5" BorderThickness="1" Padding="20"
                        RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#4D2F79" BlurRadius="14" ShadowDepth="3" Opacity="0.18" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FlipScale" ScaleX="1" ScaleY="1" />
                            <SkewTransform x:Name="FlipSkew" AngleY="0" />
                            <TranslateTransform x:Name="FlipOffset" X="0" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid x:Name="TaskContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Текущее задание" Foreground="#8B74A2" FontSize="12" />
                                <TextBlock x:Name="TaskKindText" FontWeight="SemiBold" Foreground="#643B9B"
                                           FontSize="17" Margin="0,5,0,0" />
                                <TextBlock x:Name="TaskTimeText" FontSize="12" Foreground="#90809F"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                            <ScrollViewer x:Name="TaskTextScrollViewer" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TaskBody" FontSize="14" Foreground="#34254B"
                                           TextWrapping="Wrap" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" />
                            </ScrollViewer>
                            <!-- All task links share one responsive strip: no separate Telegram row. -->
                            <Border x:Name="LinksPanel" Grid.Row="2" Margin="0,14,0,0"
                                    Padding="0" Background="Transparent" BorderThickness="0"
                                    Visibility="Collapsed">
                                <ItemsControl x:Name="TaskLinks">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="204" ItemHeight="50" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding Url}" ToolTip="{Binding Url}"
                                                    Click="OpenTaskLink_OnClick"
                                                    Style="{StaticResource LinkButton}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="↗" FontSize="15" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="FinishedPanel" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                            <TextBlock Text="✓" Foreground="#268458" FontSize="48"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Все задания выполнены" Foreground="#24154C"
                                       FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FinishedText" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="#74628A" Margin="0,10,0,0" FontSize="13" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ErrorText" Grid.Row="0" Visibility="Collapsed"
                               Foreground="#B34C62" FontSize="12" TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Text="Загружаем следующее задание…"
                                   Foreground="#75648A" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="StopButton" Grid.Column="1" Content="Остановить"
                                Background="#EDE4F6" Foreground="#593282"
                                Style="{StaticResource ActionButton}" Margin="0,0,10,0"
                                Click="StopButton_OnClick" />
                        <Button x:Name="CompleteButton" Grid.Column="2" Content="✓  Готово"
                                Background="#7545B9" Style="{StaticResource ActionButton}"
                                Click="CompleteButton_OnClick" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
