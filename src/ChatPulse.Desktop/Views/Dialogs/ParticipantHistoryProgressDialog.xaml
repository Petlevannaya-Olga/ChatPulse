<Window x:Class="ChatPulse.Desktop.Views.Dialogs.ParticipantHistoryProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatPulse — История участниц"
        Width="600" SizeToContent="Height" MaxHeight="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7545F9" Offset="0" />
            <GradientStop Color="#BA35E8" Offset="0.55" />
            <GradientStop Color="#FB239D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="135" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ActionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border Background="White" CornerRadius="19" Padding="23,20">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Восстановление истории участниц" FontSize="20" FontWeight="SemiBold"
                           Foreground="#24154C" />
                <TextBlock Text="{Binding ChatTitle}" FontSize="13" Foreground="#78658D"
                           TextWrapping="Wrap" Margin="0,7,0,14" />
                <Border Background="#F8F4FF" Padding="13" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#38265A"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#725B91"
                                   TextWrapping="Wrap" Margin="0,0,0,9" />
                        <ProgressBar Height="7" IsIndeterminate="{Binding IsRunning}"
                                     Background="#E9DFF7" Foreground="#9047DB" />
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="250" Margin="0,14,0,0">
                    <TextBlock Text="{Binding ResultDetails}" TextWrapping="Wrap" FontSize="12"
                               Foreground="#5F4C79" />
                </ScrollViewer>
                <Button Content="{Binding ActionLabel}" Click="ActionButton_OnClick"
                        Style="{StaticResource ActionButton}" IsEnabled="{Binding IsActionEnabled}"
                        HorizontalAlignment="Right" Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
