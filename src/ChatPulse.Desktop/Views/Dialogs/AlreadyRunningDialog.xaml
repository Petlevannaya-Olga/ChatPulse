<Window x:Class="ChatPulse.Desktop.Views.Dialogs.AlreadyRunningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatPulse уже запущен"
        Icon="pack://application:,,,/Resources/ChatPulse.ico"
        Width="574" Height="374"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="ChatPulsePrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7545F9" Offset="0" />
            <GradientStop Color="#BA35E8" Offset="0.53" />
            <GradientStop Color="#FB239D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ChatPulseConfirmButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{StaticResource ChatPulsePrimaryGradient}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.73" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Background="White" CornerRadius="20" Padding="32,28">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="28" ShadowDepth="8" Opacity="0.32" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="58" Height="58"
                           Source="pack://application:,,,/Resources/ChatPulseLogo.png"
                           Stretch="Uniform" />
                    <StackPanel Grid.Column="1" Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="ChatPulse уже запущен"
                                   FontSize="21" FontWeight="Bold"
                                   Foreground="#211449" />
                        <TextBlock Text="Открыто другое окно приложения"
                                   Margin="0,4,0,0" FontSize="14"
                                   Foreground="#796C98" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#F7F3FF" CornerRadius="11"
                        Margin="0,22,0,0" Padding="18,15">
                    <TextBlock TextWrapping="Wrap" FontSize="15" LineHeight="23"
                               Foreground="#39295F"
                               Text="ChatPulse поддерживает работу только в одном окне. Вернитесь к уже открытому приложению или закройте его перед повторным запуском." />
                </Border>

                <Button Grid.Row="2" Content="Понятно"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0"
                        IsDefault="True" IsCancel="True"
                        Style="{StaticResource ChatPulseConfirmButton}"
                        Click="Close_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
