<Window x:Class="ChatPulse.Desktop.Views.Dialogs.TelegramHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Как подключить Telegram — ChatPulse"
        Icon="pack://application:,,,/Resources/ChatPulse.ico"
        Width="690" Height="620" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F7F3FF" FontFamily="Segoe UI">
<Window.Resources>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <Style x:Key="ChatPulsePrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9"
                                Background="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#B9B0CF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#321953"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#2C1854" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Как подключить Telegram" FontSize="25" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Инструкция для первого подключения" Foreground="#DAD0F2" Margin="0,4,0,0" FontSize="14"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Padding="28,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="1. Откройте Telegram" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Убедитесь, что вы уже вошли в Telegram на телефоне или другом устройстве. ChatPulse подключается к существующему аккаунту." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="2. Введите номер телефона" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Код +7 уже указан в ChatPulse и не меняется. Введите 10 цифр номера Telegram: они автоматически оформятся как +7 (999) 123-45-67. Когда номер заполнен, нажмите «Получить код». Пока поддерживаются только номера с кодом +7." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="3. Найдите сообщение с кодом" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Откройте Telegram на другом устройстве и найдите сообщение от официального служебного аккаунта Telegram. Иногда Telegram предлагает другой способ подтверждения — следуйте указанным в приложении инструкциям." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="4. Введите код в ChatPulse" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Не сообщайте код другим людям и не отправляйте его в чат поддержки. Вводите его только в окно ChatPulse." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="5. При необходимости введите пароль" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="Если у вас включена двухэтапная проверка, потребуется облачный пароль Telegram. Это не код разблокировки телефона." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="6. Дождитесь подтверждения" Style="{StaticResource HeadingStyle}"/>
                <TextBlock Text="После успешного входа появится имя подключённого аккаунта. В дальнейшем ChatPulse будет использовать сохранённую локальную сессию." TextWrapping="Wrap" Margin="0,4,0,16" />
                <Border Background="#ECE3FA" CornerRadius="10" Padding="14" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Не приходит код?" FontWeight="SemiBold" Foreground="#381D67" FontSize="16"/>
                        <TextBlock Text="Проверьте интернет, номер телефона и служебный чат Telegram на уже авторизованном устройстве. Не запрашивайте код много раз подряд: Telegram может временно ограничить попытки." TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="ChatPulse использует один Telegram-аккаунт для всех подключённых чатов. Никому не передавайте файл сессии." TextWrapping="Wrap" Foreground="#6B5985" FontStyle="Italic" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#E3D8EE" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Content="Понятно" Width="180" HorizontalAlignment="Right"
                    Style="{StaticResource ChatPulsePrimaryButton}"
                    Click="CloseButton_OnClick" />
        </Border>
    </Grid>

</Window>
