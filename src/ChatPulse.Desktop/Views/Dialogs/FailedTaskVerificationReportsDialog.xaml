<Window x:Class="ChatPulse.Desktop.Views.Dialogs.FailedTaskVerificationReportsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёты проверки — ChatPulse" Width="550" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ReportCloseButton" TargetType="Button">
            <Setter Property="Background" Value="#7545B9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Border Background="White" CornerRadius="20" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="22" ShadowDepth="5" Opacity="0.3" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Неуспешные проверки" FontSize="20" FontWeight="SemiBold"
                               Foreground="#24154C" />
                    <TextBlock Text="История этого задания. Проверки не изменяли реакции Instagram."
                               FontSize="12" Foreground="#817092" TextWrapping="Wrap" Margin="0,7,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" x:Name="ReportScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ReportItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F5FC" BorderBrush="#E9DDF2"
                                        BorderThickness="1" CornerRadius="11" Margin="0,0,0,12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="#39235C" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                   Foreground="#7D6B91" TextWrapping="Wrap" Margin="0,4,0,10" />
                                        <ItemsControl ItemsSource="{Binding Checks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#39235C" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Status}"
                                                                       Foreground="{Binding StatusBrush}"
                                                                       FontWeight="SemiBold" FontSize="12" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Detail}" Foreground="#745D8D"
                                                                   FontSize="12" Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="2" Content="Закрыть" Margin="0,16,0,0"
                        Style="{StaticResource ReportCloseButton}" Click="Close_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
