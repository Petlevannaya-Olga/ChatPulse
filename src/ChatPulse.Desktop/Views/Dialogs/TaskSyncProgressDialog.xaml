<Window x:Class="ChatPulse.Desktop.Views.Dialogs.TaskSyncProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatPulse — Синхронизация заданий"
        Width="590" Height="535" MinHeight="410"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7545F9" Offset="0" />
            <GradientStop Color="#BA35E8" Offset="0.55" />
            <GradientStop Color="#FB239D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="135" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ActionBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border Background="White" CornerRadius="19" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Синхронизация заданий" FontSize="21" FontWeight="SemiBold" Foreground="#24154C" />
                    <TextBlock Text="{Binding ScopeTitle}" FontSize="12" Foreground="#78658D"
                               FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" TextWrapping="Wrap" Margin="0,6,0,13" />
                </StackPanel>
                <Border Grid.Row="1" Background="#F8F4FF" Padding="13" CornerRadius="11">
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentChatLabel}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#372353" TextWrapping="Wrap"
                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" />
                        <TextBlock Text="{Binding CurrentStage}" FontSize="12" Foreground="#6F598B"
                                   TextWrapping="Wrap" Margin="0,5,0,10" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage, Mode=OneWay}"
                                     Height="8" Background="#E9DFF7" Foreground="#9047DB" />
                        <TextBlock Text="{Binding SummaryLabel}" Margin="0,7,0,0" FontSize="12"
                                   Foreground="#5A417A" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="2" Text="Результаты по чатам" FontWeight="SemiBold"
                           Foreground="#24154C" FontSize="14" Margin="0,17,0,9" />
                <Border Grid.Row="3" BorderBrush="#E9DFF7" BorderThickness="1" CornerRadius="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Chats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0EAF8" BorderThickness="0,0,0,1" Padding="11,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#38265A" TextWrapping="Wrap"
                                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusLabel}"
                                                           Foreground="{Binding StatusBrush}" Margin="12,0,0,0"
                                                           FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#736486"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FinalMessage}" Foreground="#5A417A" FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Grid.Column="1" Style="{StaticResource ActionButton}"
                            Content="{Binding ActionLabel}" Click="ActionButton_OnClick" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
