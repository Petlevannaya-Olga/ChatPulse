<Window x:Class="ChatPulse.Desktop.Views.Dialogs.TelegramApiKeysHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Как получить API-ключи — ChatPulse"
        Icon="pack://application:,,,/Resources/ChatPulse.ico"
        Width="690" Height="620" MinWidth="580" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F7F3FF" FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0.1">
            <GradientStop Offset="0" Color="#7545F9" />
            <GradientStop Offset="0.53" Color="#BA35E8" />
            <GradientStop Offset="1" Color="#FB239D" />
        </LinearGradientBrush>
        <Style x:Key="ChatPulsePrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="176" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9" Background="{StaticResource PrimaryBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#321953" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#2C1854" Padding="26,20">
            <StackPanel>
                <TextBlock Text="Как получить API ID и API Hash" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Первичная настройка Telegram API" Foreground="#DAD0F2" Margin="0,4,0,0" FontSize="14" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" Padding="28,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Зачем нужны ключи?" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="ChatPulse — независимое приложение, использующее Telegram API. Чтобы подключить свой аккаунт, вам потребуется зарегистрировать API-приложение в Telegram. Ключи сохраняются только на вашем компьютере." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="1. Откройте официальный сайт" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Откройте браузер и перейдите на https://my.telegram.org. Используйте только официальный адрес Telegram." TextWrapping="Wrap" Margin="0,4,0,9" />
                <Button Content="Открыть my.telegram.org" Click="OpenTelegramWebsite_OnClick"
                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                        Foreground="#7545F9" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,14" />
                <TextBlock Text="2. Войдите в Telegram" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Введите номер своего Telegram-аккаунта. Получите код в служебном чате Telegram и подтвердите вход на сайте. Не сообщайте код другим людям." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="3. Откройте API development tools" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="После входа выберите раздел API development tools. Если данные приложения уже существуют, используйте их; Telegram может не разрешить создание второго приложения для того же аккаунта." TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="4. Создайте приложение, если необходимо" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="Если форма создания открылась, заполните её. Пример (названия можно изменить, Short name должен быть свободным):"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Border Background="#ECE3FA" CornerRadius="8" Padding="13,10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="App title: MyChatPulseClient" FontWeight="SemiBold" Foreground="#321953" Margin="0,0,0,3" />
                        <TextBlock Text="Short name: mychatpulseclient26" Foreground="#321953" Margin="0,0,0,3" />
                        <TextBlock Text="Platform: Desktop (если доступно)" Foreground="#321953" Margin="0,0,0,3" />
                        <TextBlock Text="URL: оставить пустым, если поле необязательное" Foreground="#321953" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBlock Text="Description: Personal desktop client for Telegram chat tasks" Foreground="#321953" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Нажмите Create application. Если Short name занят, выберите другой. Не используйте чужие ключи и не называйте приложение официальным клиентом Telegram."
                           TextWrapping="Wrap" Margin="0,0,0,16" />
                <TextBlock Text="5. Скопируйте оба параметра" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="На странице приложения найдите App api_id (положительное число) и App api_hash (строка из 32 шестнадцатеричных символов). Вернитесь в ChatPulse, вставьте каждый параметр в соответствующее поле и нажмите «Сохранить ключи»."
                           TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock Text="6. Подключите аккаунт" Style="{StaticResource HeadingStyle}" />
                <TextBlock Text="После сохранения ключей появится привычный экран ввода номера телефона. Подтвердите вход кодом и, если требуется, паролем двухэтапной проверки." TextWrapping="Wrap" Margin="0,4,0,16" />
                <Border Background="#ECE3FA" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Безопасность" FontWeight="SemiBold" Foreground="#381D67" FontSize="16" />
                        <TextBlock Text="Никому не отправляйте API Hash, коды входа или пароль 2FA. ChatPulse шифрует ключи и Telegram-сессию средствами Windows для текущего пользователя." TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Если сайт не открывается или регистрация не удаётся" Style="{StaticResource HeadingStyle}" Margin="0,3,0,0" />
                <TextBlock Text="Если my.telegram.org недоступен, проверьте интернет и адрес сайта. Не вводите номер, коды и ключи на посторонних страницах."
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <TextBlock Text="Если после кода появляется «Too many attempts», прекратите повторные попытки и попробуйте позднее: Telegram не сообщает универсального срока снятия ограничения. Если при создании приложения появляется ERROR или [object Object], сохраните текст ошибки и обратитесь в официальную поддержку Telegram."
                           TextWrapping="Wrap" Foreground="#6B5985" Margin="0,0,0,4" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="#E3D8EE" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Content="Понятно" Width="180" HorizontalAlignment="Right"
                    Style="{StaticResource ChatPulsePrimaryButton}" Click="CloseButton_OnClick" />
        </Border>
    </Grid>
</Window>
