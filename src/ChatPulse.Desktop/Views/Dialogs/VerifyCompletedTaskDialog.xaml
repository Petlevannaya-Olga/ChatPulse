<Window x:Class="ChatPulse.Desktop.Views.Dialogs.VerifyCompletedTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка задания — ChatPulse"
        Width="510" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ChatPulseDialogButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A37DE0" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="White" CornerRadius="20" Padding="26,24">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="25" ShadowDepth="6" Opacity="0.3" />
            </Border.Effect>
            <ScrollViewer x:Name="DialogScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="Проверить выполненное задание"
                               Foreground="#24154C" FontWeight="SemiBold" FontSize="20"
                               TextWrapping="Wrap" Margin="0,0,0,20" />

                    <Grid x:Name="LikeRow" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CheckLikeBox" Content="Лайк" Foreground="#39295F"
                                  FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="LikeLabel" Text="Лайк" Visibility="Collapsed"
                                   FontSize="15" Foreground="#39295F" VerticalAlignment="Center" />
                        <TextBlock x:Name="LikeStatus" Grid.Column="1" Visibility="Collapsed"
                                   FontSize="13" Foreground="#58338C" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="CommentRow" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CheckCommentBox" Content="Комментарий" Foreground="#39295F"
                                  FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="CommentLabel" Text="Комментарий" Visibility="Collapsed"
                                   FontSize="15" Foreground="#39295F" VerticalAlignment="Center" />
                        <TextBlock x:Name="CommentStatus" Grid.Column="1" Visibility="Collapsed"
                                   FontSize="13" Foreground="#58338C" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="SaveRow" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CheckSaveBox" Content="Сохранение" Foreground="#39295F"
                                  FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="SaveLabel" Text="Сохранение" Visibility="Collapsed"
                                   FontSize="15" Foreground="#39295F" VerticalAlignment="Center" />
                        <TextBlock x:Name="SaveStatus" Grid.Column="1" Visibility="Collapsed"
                                   FontSize="13" Foreground="#58338C" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="RepostRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="CheckRepostBox" Content="Репост" Foreground="#39295F"
                                  FontSize="15" VerticalAlignment="Center" />
                        <TextBlock x:Name="RepostLabel" Text="Репост" Visibility="Collapsed"
                                   FontSize="15" Foreground="#39295F" VerticalAlignment="Center" />
                        <TextBlock x:Name="RepostStatus" Grid.Column="1" Visibility="Collapsed"
                                   FontSize="13" Foreground="#58338C" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <Border x:Name="ProgressPanel" Background="#F7F3FC" Padding="12"
                            CornerRadius="9" Margin="0,18,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressText" Foreground="#5D477B"
                                   FontSize="13" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="ErrorsPanel" Background="#F7F3FC" Padding="12"
                            CornerRadius="9" Margin="0,18,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Не удалось подтвердить" Foreground="#39235C"
                                       FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5" />
                            <TextBlock x:Name="ErrorsText" Foreground="#5D477B"
                                       FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SuccessHint"
                               Text="Все выбранные действия подтверждены. После закрытия отчёта задание будет скрыто."
                               Visibility="Collapsed" Foreground="#5D477B" FontSize="12"
                               TextWrapping="Wrap" Margin="0,16,0,0" />
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="CancelButton" Content="Закрыть"
                                Click="Cancel_OnClick" Style="{StaticResource ChatPulseDialogButton}"
                                Background="#F1EBFA" Foreground="#39235C"
                                BorderBrush="Transparent" BorderThickness="1" />
                        <Button Grid.Column="2" x:Name="StartButton" Content="Проверить"
                                Click="Start_OnClick" Style="{StaticResource ChatPulseDialogButton}"
                                Background="#7545B9" Foreground="White"
                                BorderBrush="Transparent" BorderThickness="1" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
