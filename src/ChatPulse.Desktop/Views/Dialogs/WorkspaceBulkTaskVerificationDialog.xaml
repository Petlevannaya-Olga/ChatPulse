<Window x:Class="ChatPulse.Desktop.Views.Dialogs.WorkspaceBulkTaskVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Массовая проверка — ChatPulse" Width="740" Height="640" MinHeight="390"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Dialog_OnClosing">
    <Window.Resources>
        <Style x:Key="BatchActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="195" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#7545B9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BatchCloseButton" TargetType="Button" BasedOn="{StaticResource BatchActionButton}">
            <Setter Property="Foreground" Value="#69459B"/>
            <Setter Property="Background" Value="#F4EFFB"/>
            <Setter Property="MinWidth" Value="104"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border Background="White" CornerRadius="20" Padding="26,22">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="24" ShadowDepth="5" Opacity="0.28" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Массовая проверка заданий" FontSize="22" FontWeight="SemiBold" Foreground="#24154C" />
                    <TextBlock Text="Проверяются выполненные задания выбранного чата. Лайк обязателен; остальные действия определяются по тексту."
                               FontSize="12" Foreground="#75648A" TextWrapping="Wrap" Margin="0,8,0,14" />
                </StackPanel>
                <Border Grid.Row="1" Background="#FAF7FE" BorderBrush="#E8DDF5"
                        BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Режим проверки" Foreground="#342059" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <RadioButton x:Name="ExcludePreviouslyCheckedRadio" GroupName="BulkMode"
                                     IsChecked="True" Foreground="#342059" Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="Исключить ранее проверенные" FontWeight="SemiBold"/>
                                <TextBlock Text="Проверить новые задания и повторить проверки после технических сбоев."
                                           Foreground="#75648A" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="CheckAllRadio" GroupName="BulkMode"
                                     Foreground="#342059">
                            <StackPanel>
                                <TextBlock Text="Проверить все" FontWeight="SemiBold"/>
                                <TextBlock Text="Проверить все оставшиеся выполненные задания, включая ранее неподтверждённые."
                                           Foreground="#75648A" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" CornerRadius="13" Padding="15" Background="#F7F2FD">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTaskText" Text="Нажмите «Начать проверку»" FontWeight="SemiBold"
                                       Foreground="#342059" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock x:Name="CountText" Grid.Column="1" Text="0 / 0" Foreground="#7545B9"
                                       FontWeight="SemiBold" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="StageText" Text="Ожидание запуска" Foreground="#765F90"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,8,0,12" />
                        <ProgressBar x:Name="BatchProgressBar" Minimum="0" Maximum="1" Value="0"
                                     Height="10" Background="#E8DDF5" Foreground="#7545B9" />
                        <TextBlock x:Name="TotalsText" Text="Скрыто: 0 · С ошибками: 0 · Пропущено: 0"
                                   Margin="0,10,0,0" Foreground="#49336B" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="3" Text="Подробный журнал" FontWeight="SemiBold" Foreground="#24154C"
                           FontSize="14" Margin="0,17,0,10" />
                <Border Grid.Row="4" BorderThickness="1" BorderBrush="#E8DFF2" CornerRadius="11">
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="LogItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#F0E9F8" Padding="13,11">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="#382456" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                           FontWeight="SemiBold" FontSize="11" Margin="12,0,0,0" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Foreground="#75618A" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FinalMessage" Text="Остановка выполняется после завершения текущего задания."
                               Foreground="#765F90" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CloseButton" Style="{StaticResource BatchCloseButton}"
                                Content="Закрыть" Margin="0,0,10,0" Click="CloseButton_OnClick" />
                        <Button x:Name="ActionButton" Style="{StaticResource BatchActionButton}"
                                Content="Начать проверку" Click="ActionButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
