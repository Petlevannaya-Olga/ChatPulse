<Window x:Class="ChatPulse.Desktop.Views.Dialogs.ParticipantListSyncProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatPulse — Синхронизация списка участниц"
        Width="560" SizeToContent="Height" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible" />
        <LinearGradientBrush x:Key="ActionBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7545F9" Offset="0" />
            <GradientStop Color="#BB35E8" Offset="0.55" />
            <GradientStop Color="#FB239D" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="125" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource ActionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Border Background="White" CornerRadius="19" Padding="23,19">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock Text="Синхронизация списка участниц" FontSize="20" FontWeight="SemiBold"
                               Foreground="#24154C" />
                    <TextBlock Text="Ищем самый свежий список в выбранном Telegram-чате"
                               FontSize="12" Foreground="#796C98" Margin="0,5,0,12" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStopped}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="23" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="95" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Marker}" Foreground="{Binding StateColor}"
                                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" Foreground="#352353"
                                               FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Foreground="{Binding StateColor}"
                                               FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SourceMessageDateLabel}" Margin="0,10,0,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="#6D38A9"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSourceMessageDate, Converter={StaticResource BoolVisible}}" />
                    <Border Margin="0,12,0,0" Background="#F8F4FF" CornerRadius="10" Padding="12"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolVisible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentDetail}" FontSize="12" Foreground="#4E3577"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressLabel}" Foreground="#4E3577"
                                           FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding PercentageLabel}" Foreground="#4E3577"
                                           FontSize="12" FontWeight="SemiBold" TextAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="8" Minimum="0" Maximum="100"
                                         Value="{Binding Percentage, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                         Foreground="#9047DB" Background="#E6DDF5" />
                            <TextBlock Text="Количество сообщений в истории заранее неизвестно."
                                       FontSize="11" Foreground="#8B7CA0" Margin="0,7,0,0"
                                       Visibility="{Binding IsIndeterminate, Converter={StaticResource BoolVisible}}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Background="#FAF7FF" CornerRadius="11"
                            BorderBrush="#E8DDF5" BorderThickness="1" Padding="13"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolVisible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold" FontSize="15"
                                       Foreground="#6D38A9" />
                            <TextBlock Text="{Binding ResultDetail}" Margin="0,6,0,0" FontSize="12"
                                       Foreground="#67547D" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button HorizontalAlignment="Right" Margin="0,17,0,0"
                            Content="{Binding ActionLabel}" Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding CanAct}" Click="ActionButton_OnClick" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
