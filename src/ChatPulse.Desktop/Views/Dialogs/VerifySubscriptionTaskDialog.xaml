<Window x:Class="ChatPulse.Desktop.Views.Dialogs.VerifySubscriptionTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка подписки — ChatPulse"
        Width="520" SizeToContent="Height" MaxHeight="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ChatPulseDialogButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Border Background="White" CornerRadius="18" Padding="26,23">
            <Border.Effect>
                <DropShadowEffect Color="#18083A" BlurRadius="25" ShadowDepth="5" Opacity="0.3" />
            </Border.Effect>
            <ScrollViewer x:Name="DialogScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="Проверить подписку"
                               Foreground="#24154C" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel x:Name="SelectionPanel" Margin="0,16,0,4">
                        <TextBlock x:Name="TaskSummary" Foreground="#5D477B" FontSize="13"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="TargetSelectionPanel" Margin="0,15,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="Участница" Foreground="#39295F"
                                       FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="TargetPicker" IsEditable="False" Margin="0,8,0,4"
                                      Height="38" Foreground="#39295F" FontSize="13"
                                      ToolTip="Выберите профиль участницы из задания" />
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="ResultRow" Visibility="Collapsed" Margin="0,10,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultLabel" Text="Подписка" Foreground="#39295F"
                                   FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="ResultStatus" Grid.Column="1" Foreground="#6841A0"
                                   FontWeight="SemiBold" FontSize="13" Margin="12,0,0,0" />
                    </Grid>
                    <Border x:Name="ProgressPanel" Background="#F7F3FC" CornerRadius="10"
                            Padding="12" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ProgressText" Foreground="#5D477B" FontSize="13" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="ErrorPanel" Background="#F7F3FC" CornerRadius="10"
                            Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Foreground="#5D477B" FontSize="13" TextWrapping="Wrap" />
                    </Border>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CloseButton" Grid.Column="0" Height="42" Content="Закрыть"
                                Style="{StaticResource ChatPulseDialogButton}"
                                Background="#F1EBFA" Foreground="#39235C" BorderThickness="0"
                                Click="Close_OnClick" FontWeight="SemiBold" />
                        <Button x:Name="CheckButton" Grid.Column="2" Height="42" Content="Проверить"
                                Style="{StaticResource ChatPulseDialogButton}"
                                Background="#7545B9" Foreground="White" BorderThickness="0"
                                Click="Check_OnClick" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
