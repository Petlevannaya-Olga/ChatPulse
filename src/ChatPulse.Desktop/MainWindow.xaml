<Window x:Class="ChatPulse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:onboarding="clr-namespace:ChatPulse.Desktop.Views.Onboarding"
        xmlns:workspace="clr-namespace:ChatPulse.Desktop.Views.Workspace"
        Title="ChatPulse — Пульс ваших чатов"
        Icon="pack://application:,,,/Resources/ChatPulse.ico"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ConnectionBoolToVisibility" />
    </Window.Resources>
    <Grid>
        <onboarding:WelcomeView x:Name="WelcomeScreen"
                                StartRequested="WelcomeScreen_OnStartRequested" />
        <onboarding:OnboardingStepOneView x:Name="FirstStepScreen"
                                         BackRequested="FirstStepScreen_OnBackRequested"
                                         ContinueRequested="FirstStepScreen_OnContinueRequested"
                                         Visibility="Collapsed" />
        <onboarding:OnboardingStepTwoView x:Name="SecondStepScreen"
                                         BackRequested="SecondStepScreen_OnBackRequested"
                                         ContinueRequested="SecondStepScreen_OnContinueRequested"
                                         Visibility="Collapsed" />
        <onboarding:OnboardingStepThreeView x:Name="ThirdStepScreen"
                                           BackRequested="ThirdStepScreen_OnBackRequested"
                                           Visibility="Collapsed" />

        <onboarding:OnboardingStepFourView x:Name="FourthStepScreen"
                                          Visibility="Collapsed" />
        <workspace:WorkspaceView x:Name="WorkspaceScreen" Visibility="Collapsed" />

        <!-- Единый индикатор связи. Не модальный: пользователь сохраняет доступ к интерфейсу. -->
        <Border x:Name="ConnectionNotice" Panel.ZIndex="8"
                MaxWidth="490" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,24,0" Padding="14,11"
                Background="#FFF8F3FF" BorderBrush="#DDC7F6" BorderThickness="1"
                CornerRadius="14" Visibility="{Binding IsWarningVisible, Converter={StaticResource ConnectionBoolToVisibility}}"
                AutomationProperties.LiveSetting="Polite">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="!" FontWeight="Bold" FontSize="16"
                           Foreground="#A23C75" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding NoticeText}" FontSize="13"
                           FontWeight="SemiBold" Foreground="#2B1C52"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Повторить" Click="RetryConnectionButton_OnClick"
                        Visibility="{Binding CanRetry, Converter={StaticResource ConnectionBoolToVisibility}}"
                        Margin="12,0,0,0" Padding="10,5" FontSize="12" Foreground="#7739BC"
                        Background="White" BorderBrush="#D8C4F6" BorderThickness="1" />
            </Grid>
        </Border>

        <!-- Затемнение родительского окна, как в Mnemora. -->
        <Border x:Name="DialogOverlay"
                Background="#940D0825"
                Visibility="Collapsed"
                Panel.ZIndex="10" />
    </Grid>
</Window>
