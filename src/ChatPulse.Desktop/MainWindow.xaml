<Window x:Class="ChatPulse.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:onboarding="clr-namespace:ChatPulse.Desktop.Views.Onboarding"
        Title="ChatPulse — Пульс ваших чатов"
        Icon="pack://application:,,,/Resources/ChatPulse.ico"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <onboarding:WelcomeView x:Name="WelcomeScreen"
                                StartRequested="WelcomeScreen_OnStartRequested" />
        <onboarding:OnboardingStepOneView x:Name="FirstStepScreen"
                                         BackRequested="FirstStepScreen_OnBackRequested"
                                         ContinueRequested="FirstStepScreen_OnContinueRequested"
                                         Visibility="Collapsed" />
        <onboarding:OnboardingStepTwoView x:Name="SecondStepScreen"
                                         BackRequested="SecondStepScreen_OnBackRequested"
                                         Visibility="Collapsed" />

        <!-- Затемнение родительского окна, как в Mnemora. -->
        <Border x:Name="DialogOverlay"
                Background="#940D0825"
                Visibility="Collapsed"
                Panel.ZIndex="10" />
    </Grid>
</Window>
